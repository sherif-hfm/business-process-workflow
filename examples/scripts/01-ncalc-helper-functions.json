    },
    {
      "id": 2,
      "name": "Evaluate Helpers in Order",
      "externalId": "SCRIPT_EVALUATE_NCALC_HELPERS",
      "type": "scriptTask",
      "laneId": 1,
      "x": 320,
      "y": 170,
      "roles": [],
      "variables": [],
      "scriptFormat": "ncalc",
      "assignments": [
        {
          "variable": "normalizedText",
          "expression": "Trim(rawText)"
        },
        {
          "variable": "lengthValue",
          "expression": "Length(normalizedText)"
        },
        {
          "variable": "lenAliasValue",
          "expression": "Len(normalizedText)"
        },
        {
          "variable": "emptyCheck",
          "expression": "IsNullOrEmpty(normalizedText)"
        },
        {
          "variable": "whitespaceCheck",
          "expression": "IsNullOrWhiteSpace(blankText)"
        },
        {
          "variable": "containsCheck",
          "expression": "Contains(normalizedText, 'flowbit')"
        },
        {
          "variable": "startsWithCheck",
          "expression": "StartsWith(normalizedText, 'flow')"
        },
        {
          "variable": "endsWithCheck",
          "expression": "EndsWith(normalizedText, 'examples')"
        },
        {
          "variable": "upperText",
          "expression": "Upper(normalizedText)"
        },
        {
          "variable": "lowerText",
          "expression": "Lower(upperText)"
        },
        {
          "variable": "regexCheck",
          "expression": "IsMatch(normalizedText, '^flowbit examples$')"
        },
        {
          "variable": "boundedLength",
          "expression": "Max(10, Min(25, lengthValue))"
        },
        {
          "variable": "sizeLabel",
          "expression": "if(lenAliasValue >= 10, 'long', 'short')"
        },
        {
          "variable": "knownLabel",
          "expression": "in(sizeLabel, 'short', 'long')"
        },
        {
          "variable": "mathResult",
          "expression": "Round(Pow(2, 3) + Sqrt(16), 0)"
        }
      ],
      "script": null,
      "usesFlowInfo": false
    },
    {
