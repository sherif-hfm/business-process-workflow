{
  "id": "example-flowinfo-ncalc-javascript",
  "name": "Script Example 03 - FlowInfo in NCalc and JavaScript",
  "initialEventId": 1,
  "variables": [
    {
      "id": 1,
      "name": "actionCount",
      "dataType": "number",
      "isArray": false,
      "required": false,
      "defaultValue": 0,
      "validation": "actionCount >= 0"
    },
    {
      "id": 2,
      "name": "traversalCount",
      "dataType": "number",
      "isArray": false,
      "required": false,
      "defaultValue": 0,
      "validation": "traversalCount >= 0"
    },
    {
      "id": 3,
      "name": "selectedActor",
      "dataType": "string",
      "isArray": false,
      "required": false,
      "defaultValue": "none"
    },
    {
      "id": 4,
      "name": "ncalcEvidence",
      "dataType": "json",
      "isArray": false,
      "required": false,
      "defaultValue": {}
    },
    {
      "id": 5,
      "name": "javascriptEvidence",
      "dataType": "json",
      "isArray": false,
      "required": false,
      "defaultValue": {}
    }
  ],
  "lanes": [
    {
      "id": 1,
      "name": "Evidence Capture and Routing",
      "externalId": "LANE_FLOW_EVIDENCE",
      "x": 30,
      "y": 30,
      "w": 1770,
      "h": 620
    }
  ],
  "flowNodes": [
    {
      "id": 1,
      "name": "Start Evidence Example",
      "externalId": "START_FLOWINFO",
      "type": "startEvent",
      "laneId": 1,
      "x": 70,
      "y": 285,
      "roles": [],
      "variables": []
    },
    {
      "id": 2,
      "name": "Choose an Outcome",
      "externalId": "TASK_CHOOSE_EVIDENCE_OUTCOME",
      "type": "userTask",
      "laneId": 1,
      "x": 280,
      "y": 270,
      "roles": [
        "ExampleReviewer"
      ],
      "variables": [],
      "requiresClaim": false,
      "claimMode": "fresh"
    },
    {
      "id": 3,
      "name": "Read Evidence with NCalc",
      "externalId": "SCRIPT_READ_FLOWINFO_NCALC",
      "type": "scriptTask",
      "laneId": 1,
      "x": 610,
      "y": 270,
      "roles": [],
      "variables": [],
      "scriptFormat": "ncalc",
      "assignments": [
        {
          "variable": "actionCount",
          "expression": "FlowInfo(201, 'actions.count') + FlowInfo(202, 'actions.count')"
        },
        {
          "variable": "traversalCount",
          "expression": "FlowInfo(201, 'traversals.count') + FlowInfo(202, 'traversals.count')"
        },
        {
          "variable": "selectedActor",
          "expression": "if(FlowInfo(201, 'actions.count') > 0, FlowInfo(201, 'actions.last.user'), FlowInfo(202, 'actions.last.user'))"
        },
        {
          "variable": "ncalcEvidence",
          "expression": "if(FlowInfo(201, 'actions.count') > 0, FlowInfo(201, 'all'), FlowInfo(202, 'all'))"
        }
      ],
      "script": null,
      "usesFlowInfo": false
    },
    {
      "id": 4,
      "name": "Read Evidence with JavaScript",
      "externalId": "SCRIPT_READ_FLOWINFO_JAVASCRIPT",
      "type": "scriptTask",
      "laneId": 1,
      "x": 940,
      "y": 270,
      "roles": [],
      "variables": [],
      "scriptFormat": "javascript",
      "assignments": [],
      "script": "const accepted = execution.getFlowInfo(201);\nconst returned = execution.getFlowInfo(202);\nexecution.setVariable('javascriptEvidence', { accepted: accepted, returned: returned });",
      "usesFlowInfo": true
    },
    {
      "id": 5,
      "name": "Route from Lifetime Evidence",
      "externalId": "GATEWAY_ROUTE_FLOWINFO",
      "type": "exclusiveGateway",
      "laneId": 1,
      "x": 1260,
      "y": 275,
      "roles": [],
      "variables": []
    },
    {
      "id": 6,
      "name": "Accepted Path Completed",
