      "scriptFormat": "javascript",
      "assignments": [],
      "script": "const source = execution.getVariable('sourceName');\nconst all = execution.getVariables();\nconst exists = execution.hasVariable('retryCount');\nexecution.setVariable('normalizedName', String(source).trim().toLowerCase());\nexecution.setVariable('retryCount', Number(all.retryCount) + 1);\nexecution.setVariable('enabled', !Boolean(all.enabled));\nexecution.setVariable('tags', ['seed', 'javascript', 'bridge']);\nexecution.setVariable('payload', { source: 'javascript', ok: true, values: [1, 2, 3], prior: all.payload });\nexecution.setVariable('variablesSnapshot', { sourceName: all.sourceName, retryBefore: all.retryCount, tagCount: all.tags.length });\nexecution.setVariable('hasRetryCount', exists);\nexecution.setVariable('processedDate', '2026-08-01');\nexecution.setVariable('processedAt', '2026-08-01T12:30:00Z');",
      "usesFlowInfo": false
