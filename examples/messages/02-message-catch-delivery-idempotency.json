      "inheritAssignmentFromNodeId": null,
      "variables": [],
      "assignee": null,
      "multiInstance": null,
      "attachedToRef": null,
      "errorVariable": null,
      "message": {
        "clientId": "${setting.examples.messageClientId}",
        "clientSecret": "${config.exampleMessageClientSecret}",
        "headerName": "X-Purchase-Order",
        "headerValue": "${purchaseOrderId}",
        "headerValidation": "header == purchaseOrderId and StartsWith(header, 'PO-')",
        "outputMappings": [
          {
            "variable": "acknowledged",
            "path": "receipt.accepted",
            "dataType": "boolean",
            "isArray": false,
            "required": true,
            "defaultValue": null,
            "validation": "acknowledged == true"
          },
          {
            "variable": "receiptCode",
            "path": "receipt.code",
            "dataType": "string",
            "isArray": false,
            "required": true,
            "defaultValue": null,
            "validation": "StartsWith(receiptCode, 'RCPT-')"
          },
          {
            "variable": "receivedAmount",
            "path": "receipt.amount",
            "dataType": "number",
            "isArray": false,
            "required": true,
            "defaultValue": null,
            "validation": "receivedAmount >= 0"
          },
          {
            "variable": "receivedAt",
            "path": "receipt.receivedAt",
            "dataType": "datetime",
            "isArray": false,
            "required": false,
            "defaultValue": "2026-01-01T00:00:00Z",
            "validation": null
          },
          {
            "variable": "warnings",
            "path": "receipt.warnings",
            "dataType": "string",
            "isArray": true,
            "required": false,
            "defaultValue": [],
            "validation": null
          },
          {
            "variable": "providerPayload",
            "path": "receipt",
            "dataType": "json",
            "isArray": false,
            "required": true,
            "defaultValue": null,
            "validation": null
          }
        ],
        "deliveryIdempotency": true,
        "deliveryIdempotencyHeaderName": "X-Flowbit-Delivery-Key"
      }
    },
