@page "/instance-version-changes"
@implements IAsyncDisposable
@using System.Text
@using System.Text.Json
@using Flowbit.Ui.Auth
@inject WorkflowApiClient Api
@inject TokenState Token

<PageTitle>Batch instance version changes · Flowbit</PageTitle>

<PageHeader Eyebrow="Manage" Title="Batch instance version changes"
            Description="Freeze running instances, prepare strict compatibility checks, and move the eligible population to one published workflow version.">
    <Actions>
        <button class="btn btn-outline-secondary" @onclick="RefreshAllAsync" disabled="@loading"><AppIcon Name="refresh" /> Refresh</button>
    </Actions>
</PageHeader>

<div class="alert alert-warning version-change-warning" role="note">
    <strong>This changes running instances in place; it is not a rollback.</strong>
    Preparation freezes the requested population and checks every instance independently. No instance moves until the ready batch is confirmed,
    and blocked or stale instances remain unchanged.
</div>

@if (!string.IsNullOrWhiteSpace(error))
{
    <div class="alert alert-danger" role="alert">@error</div>
}
@if (!string.IsNullOrWhiteSpace(success))
{
    <div class="alert alert-success" role="status">@success</div>
}

@if (!Token.HasToken)
{
    <section class="panel">
        <EmptyState Icon="token" Title="An authenticated identity is required"
                    Description="Set a test identity with one of the configured Workflow.RequiredRole roles before preparing version changes.">
            <a class="btn btn-primary" href="token">Set test identity</a>
        </EmptyState>
    </section>
}
else
{
    <section class="panel mb-3" aria-labelledby="version-definition-heading">
        <div class="section-heading">
            <div>
                <h2 id="version-definition-heading">1. Choose the exact version change</h2>
                <p>Every selected instance must currently use the same immutable source definition. The target must be a different published version in that workflow family.</p>
            </div>
        </div>

        @if (workflowFamilies is null)
        {
            <div class="skeleton" role="status"></div>
        }
        else if (workflowFamilies.Count == 0)
        {
            <EmptyState Icon="workflows" Title="No workflow definitions" Description="No workflow family is available to the current identity." />
        }
        else
        {
            <div class="version-definition-grid">
                <div>
                    <label class="form-label" for="version-change-family">Workflow family <span class="required-mark">*</span></label>
                    <select id="version-change-family" class="form-select" value="@selectedWorkflowKey"
                            @onchange="OnWorkflowFamilyChangedAsync" disabled="@loadingDefinition">
                        @foreach (var workflow in workflowFamilies)
                        {
                            <option value="@workflow.WorkflowKey">@workflow.Name (@workflow.WorkflowKey)</option>
                        }
                    </select>
                </div>
                <div>
                    <label class="form-label" for="version-change-source">Exact source version <span class="required-mark">*</span></label>
                    <select id="version-change-source" class="form-select" value="@SelectedSourceWorkflowIdText"
                            @onchange="OnSourceWorkflowChangedAsync" disabled="@(loadingDefinition || workflowVersions.Count == 0)">
                        @foreach (var version in workflowVersions)
                        {
                            <option value="@version.Id">v@(version.Version) · definition #@version.Id@(version.IsPublished ? " · published" : " · unpublished")</option>
                        }
                    </select>
                </div>
                <div>
                    <label class="form-label" for="version-change-target">Published target version <span class="required-mark">*</span></label>
                    <select id="version-change-target" class="form-select" value="@SelectedTargetWorkflowIdText"
                            @onchange="OnTargetWorkflowChanged" disabled="@(loadingDefinition || TargetVersions.Count == 0)">
                        @foreach (var version in TargetVersions)
                        {
                            <option value="@version.Id">v@(version.Version) · @VersionDirectionLabel(version) · definition #@version.Id</option>
                        }
                    </select>
                </div>
            </div>

            @if (loadingDefinition)
            {
                <div class="skeleton mt-3" role="status"></div>
            }
            else if (SelectedSourceWorkflow is not null && TargetVersions.Count == 0)
            {
                <div class="alert alert-secondary mt-3 mb-0">There is no other published version in this workflow family.</div>
            }
            else if (SelectedSourceWorkflow is { } source && SelectedTargetWorkflow is { } target)
            {
                <div class="alert alert-info mt-3 mb-0">
                    Searching running instances on <strong>v@(source.Version), definition #@source.Id</strong> and preparing a
                    <strong>@VersionDirectionLabel(target).ToLowerInvariant()</strong> to <strong>v@(target.Version), definition #@target.Id</strong>.
                </div>
            }
        }
    </section>

    <section class="filter-panel mb-3" aria-labelledby="version-search-heading">
        <div class="section-heading">
            <div>
                <h2 id="version-search-heading">2. Search running instances</h2>
                <p>The exact source definition and running status are always enforced by the server.</p>
            </div>
        </div>
        <div class="filter-grid">
            <div><label class="form-label" for="version-instance-id">Instance ID</label><input id="version-instance-id" type="number" class="form-control" value="@candidateInstanceId" @oninput="OnCandidateInstanceIdInput" /></div>
            <div><label class="form-label" for="version-business-key">Business key</label><input id="version-business-key" class="form-control" value="@candidateBusinessKey" @oninput="OnCandidateBusinessKeyInput" /></div>
            <div><label class="form-label" for="version-node-id">Current node ID</label><input id="version-node-id" type="number" class="form-control" value="@candidateNodeId" @oninput="OnCandidateNodeIdInput" /></div>
            <div><label class="form-label" for="version-node-external-id">Current node external ID</label><input id="version-node-external-id" class="form-control" value="@candidateNodeExternalId" @oninput="OnCandidateNodeExternalIdInput" /></div>
            <div class="filter-span-2">
                <AdvancedVariableFilterEditor Id="version-variable-filter"
                                              Label="Advanced current-variable filter (JSON)"
                                              Value="@candidateVariableFilterJson"
                                              ValueChanged="OnCandidateVariableFilterChanged"
                                              Error="@candidateVariableFilterError" />
            </div>
            <div class="form-check align-self-center">
                <input id="version-include-variables" class="form-check-input" type="checkbox" checked="@includeVariables"
                       @onchange="OnIncludeVariablesChanged" @onchange:stopPropagation="true" />
                <label class="form-check-label" for="version-include-variables">Include variables in results</label>
            </div>
            <div class="filter-actions">
                <button class="btn btn-primary" @onclick="SearchCandidatesAsync" disabled="@(!CanSearchCandidates)"><AppIcon Name="search" /> Search instances</button>
                <button class="btn btn-outline-secondary" @onclick="ClearCandidateFiltersAsync" disabled="@candidateLoading">Clear filters</button>
            </div>
        </div>
    </section>

    <section class="panel panel-flush mb-3" aria-labelledby="version-candidates-heading">
        <div class="section-heading px-3 pt-3">
            <div>
                <h2 id="version-candidates-heading">3. Select the frozen population</h2>
                <p>@CandidateSummary</p>
            </div>
            @if (candidates is not null && candidates.TotalCount > 0 && !candidateFiltersDirty)
            {
                <div class="d-flex flex-wrap gap-2">
                    <button class="btn btn-sm btn-outline-secondary" @onclick="SelectCurrentCandidatePage">Select this page</button>
                    <button class="btn btn-sm btn-outline-secondary" @onclick="ClearSelection">@(allMatchingSelection ? "Clear exclusions" : "Clear selection")</button>
                </div>
            }
        </div>

        @if (candidateFiltersDirty)
        {
            <EmptyState Icon="search" Title="Search the changed filters" Description="The prior result and selection will not be used for batch preparation." />
        }
        else if (candidateLoading)
        {
            <div class="p-3"><div class="skeleton" role="status"></div></div>
        }
        else if (candidates is null)
        {
            <EmptyState Icon="search" Title="Search for instances" Description="Choose an exact source and published target, then run a search." />
        }
        else if (candidates.Items.Count == 0)
        {
            <EmptyState Icon="instances" Title="No running instances" Description="No instance on the exact source version matches the current filters." />
        }
        else
        {
            <div class="px-3 pb-3">
                <div class="version-selection-mode-grid mb-3">
                    <label class="version-selection-mode-card">
                        <input type="radio" name="version-selection-mode" checked="@(!allMatchingSelection)" @onchange="_ => SetSelectionMode(false)" />
                        <span><strong>Explicit instances</strong><small>Freeze only checked instance ids across visited pages.</small></span>
                    </label>
                    <label class="version-selection-mode-card">
                        <input type="radio" name="version-selection-mode" checked="@allMatchingSelection" @onchange="_ => SetSelectionMode(true)" />
                        <span><strong>All @candidates.TotalCount.ToString("N0") matching</strong><small>Freeze the server-side filter result except unchecked exclusions.</small></span>
                    </label>
                </div>
                <div class="alert @(SelectedCandidateCount > MaxBatchInstances ? "alert-danger" : "alert-info") py-2 mb-0">
                    Selected instances: <strong>@SelectedCandidateCount.ToString("N0")</strong>.
                    The server rejects a frozen population above @MaxBatchInstances.ToString("N0") instances.
                </div>
            </div>

            <div class="table-responsive">
                <table class="table align-middle">
                    <caption class="visually-hidden">Running workflow instances available for version change</caption>
                    <thead><tr><th><span class="visually-hidden">Select</span></th><th>Instance</th><th>Workflow</th><th>Execution positions</th><th>Status</th>@if (appliedIncludeVariables) { <th>Variables</th> }<th>Updated</th></tr></thead>
                    <tbody>
                        @foreach (var candidate in candidates.Items)
                        {
                            <tr>
                                <td><input class="form-check-input" type="checkbox" aria-label="Select instance @candidate.InstanceId" checked="@IsCandidateSelected(candidate.InstanceId)" @onchange="_ => ToggleCandidate(candidate.InstanceId)" /></td>
                                <td><a class="data-title" href="@($"instances/{candidate.InstanceId}")">Instance #@candidate.InstanceId</a><span class="data-subtitle">@(candidate.BusinessKey ?? "No business key")</span></td>
                                <td>@candidate.WorkflowName<span class="data-subtitle">v@(candidate.WorkflowVersion) · definition #@candidate.WorkflowDefinitionId</span></td>
                                <td><ExecutionPositionList Positions="@candidate.ExecutionPositions" Compact="true" MaxItems="3" /></td>
                                <td><StatusBadge Status="@candidate.Status" /></td>
                                @if (appliedIncludeVariables)
                                {
                                    <td><VariableValues Values="@candidate.Variables" /></td>
                                }
                                <td>@candidate.UpdatedAt.ToLocalTime().ToString("g")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="pagination-bar">
                <span class="pagination-copy">Page @candidatePage of @CandidateTotalPages · @candidates.TotalCount.ToString("N0") total</span>
                <div class="d-flex gap-2">
                    <button class="btn btn-sm btn-outline-secondary" disabled="@(candidateLoading || candidatePage <= 1)" @onclick="PreviousCandidatePageAsync">Previous</button>
                    <button class="btn btn-sm btn-outline-secondary" disabled="@(candidateLoading || candidatePage >= CandidateTotalPages)" @onclick="NextCandidatePageAsync">Next</button>
                </div>
            </div>
        }
    </section>

    <section class="panel mb-3" aria-labelledby="version-prepare-heading">
        <div class="section-heading">
            <div><h2 id="version-prepare-heading">4. Provide the audit reason and prepare</h2><p>Compatibility preparation is durable and does not move an instance.</p></div>
        </div>
        <label class="form-label" for="version-change-reason">Reason <span class="required-mark">*</span></label>
        <textarea id="version-change-reason" class="form-control" rows="4" value="@reason" @oninput="OnReasonChanged"
                  placeholder="Explain why this selected population must change workflow version."></textarea>
        <div class="form-text">Required, 1–1,000 Unicode characters after trimming. @ReasonLength / 1,000</div>
        <div class="d-flex flex-wrap align-items-center gap-3 mt-3">
            <button class="btn btn-primary" @onclick="CreateBatchAsync" disabled="@(!CanCreateBatch)">@(batchOperation ? "Submitting…" : "Prepare compatibility asynchronously")</button>
            <span class="text-muted small">Only a later confirmation can queue compatible instances for change.</span>
        </div>
    </section>

    @if (currentBatch is not null)
    {
        var summary = currentBatch.Summary;
        <section class="panel panel-flush mb-3" aria-labelledby="version-current-batch-heading">
            <div class="section-heading px-3 pt-3">
                <div>
                    <span class="page-eyebrow">Batch #@summary.Id</span>
                    <h2 id="version-current-batch-heading">Compatibility and execution</h2>
                    <p>@summary.SourceWorkflow.WorkflowKey · v@(summary.SourceWorkflow.Version) to v@(summary.TargetWorkflow.Version) · @summary.Direction</p>
                </div>
                <div class="d-flex flex-wrap gap-2 align-items-center">
                    <StatusBadge Status="@summary.Status" />
                    <button class="btn btn-sm btn-outline-secondary" @onclick="RefreshCurrentBatchAsync" disabled="@refreshingBatch"><AppIcon Name="refresh" /> Refresh</button>
                </div>
            </div>
            <div class="summary-grid px-3 pb-3">
                <div class="summary-item"><span>Instances</span><strong>@summary.TotalItemCount.ToString("N0")</strong></div>
                <div class="summary-item"><span>Eligible</span><strong>@summary.EligibleItemCount.ToString("N0")</strong></div>
                <div class="summary-item"><span>With warnings</span><strong>@summary.WarningItemCount.ToString("N0")</strong></div>
                <div class="summary-item"><span>Stale</span><strong>@summary.StaleItemCount.ToString("N0")</strong></div>
                <div class="summary-item"><span>Blocked</span><strong>@summary.BlockedItemCount.ToString("N0")</strong></div>
                <div class="summary-item"><span>Succeeded</span><strong>@summary.SucceededItemCount.ToString("N0")</strong></div>
                <div class="summary-item"><span>Queued</span><strong>@summary.QueuedItemCount.ToString("N0")</strong></div>
                <div class="summary-item"><span>Skipped</span><strong>@summary.SkippedItemCount.ToString("N0")</strong></div>
                <div class="summary-item"><span>Failed</span><strong>@summary.FailedItemCount.ToString("N0")</strong></div>
                <div class="summary-item"><span>Cancelled</span><strong>@summary.CancelledItemCount.ToString("N0")</strong></div>
            </div>
            <div class="border-top px-3 py-3">
                <h3 class="h6">Frozen request</h3>
                <dl class="row mb-2">
                    <dt class="col-md-2">Source</dt><dd class="col-md-10">@summary.SourceWorkflow.Name · v@(summary.SourceWorkflow.Version) · definition #@summary.SourceWorkflow.Id</dd>
                    <dt class="col-md-2">Target</dt><dd class="col-md-10">@summary.TargetWorkflow.Name · v@(summary.TargetWorkflow.Version) · definition #@summary.TargetWorkflow.Id</dd>
                    <dt class="col-md-2">Reason</dt><dd class="col-md-10 text-break">@summary.Reason</dd>
                    <dt class="col-md-2">Prepared by</dt><dd class="col-md-10">@summary.PreparedBy (@RoleSnapshot(currentBatch.PreparedByRoles))</dd>
                    <dt class="col-md-2">Confirmed by</dt><dd class="col-md-10">@(summary.ConfirmedBy is null ? "Not confirmed" : $"{summary.ConfirmedBy} ({RoleSnapshot(currentBatch.ConfirmedByRoles)})")</dd>
                </dl>
                <details><summary class="section-link">Selection snapshot</summary><pre class="version-change-json mt-2">@FormatJson(currentBatch.Selection)</pre></details>
            </div>
            @if (currentBatch.Issues is not null)
            {
                <div class="px-3 pb-3"><details><summary class="section-link">Batch preparation issues</summary><pre class="version-change-json mt-2">@FormatJson(currentBatch.Issues.Value)</pre></details></div>
            }
            <div class="d-flex flex-wrap gap-2 px-3 pb-3">
                @if (CanConfirmCurrentBatch)
                {
                    <button class="btn btn-primary" @onclick="ConfirmCurrentBatchAsync" disabled="@batchOperation">
                        Confirm @summary.EligibleItemCount.ToString("N0") eligible instance(s) (@summary.WarningItemCount.ToString("N0") with warnings)
                    </button>
                }
                @if (CanCancelCurrentBatch)
                {
                    <input class="form-control version-cancellation-input" maxlength="1000" @bind="cancellationReason" placeholder="Cancellation reason (optional)" aria-label="Cancellation reason" />
                    <button class="btn btn-outline-danger" @onclick="CancelCurrentBatchAsync" disabled="@batchOperation">Cancel unstarted instances</button>
                }
            </div>

            <div class="border-top px-3 pt-3">
                <div class="section-heading">
                    <div><h3 class="h6 mb-0">Paged instance results</h3><p>@(batchItems is null ? "Loading items…" : $"{batchItems.TotalCount:N0} matching items")</p></div>
                    <select class="form-select version-status-filter" value="@batchItemStatus" @onchange="OnBatchItemStatusChangedAsync" aria-label="Filter batch items by status">
                        @foreach (var option in BatchItemStatusOptions) { <option value="@option.Value">@option.Label</option> }
                    </select>
                </div>
            </div>
            @if (batchItems is null)
            {
                <div class="p-3"><div class="skeleton"></div></div>
            }
            else if (batchItems.Items.Count == 0)
            {
                <div class="px-3 pb-3"><EmptyState Icon="instances" Title="No items in this view" Description="Preparation may still be running, or no item has the selected status." /></div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table align-middle">
                        <thead><tr><th>Item</th><th>Instance</th><th>Captured fence</th><th>Compatibility / result</th><th>Status</th><th>Updated</th></tr></thead>
                        <tbody>
                            @foreach (var item in batchItems.Items)
                            {
                                <tr>
                                    <td>#@item.Id</td>
                                    <td><a class="data-title" href="@($"instances/{item.InstanceId}")">Instance #@item.InstanceId</a><span class="data-subtitle">@(item.BusinessKey ?? "No business key")</span></td>
                                    <td>Definition #@item.CapturedSourceWorkflowId<span class="data-subtitle">@item.CapturedInstanceUpdatedAt.ToLocalTime().ToString("g")</span></td>
                                    <td class="version-result-cell">@BatchItemResult(item)</td>
                                    <td><StatusBadge Status="@item.Status" /></td>
                                    <td>@item.UpdatedAt.ToLocalTime().ToString("g")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="pagination-bar">
                    <span class="pagination-copy">Page @batchItemPage of @BatchItemTotalPages</span>
                    <div class="d-flex gap-2">
                        <button class="btn btn-sm btn-outline-secondary" disabled="@(batchItemPage <= 1 || refreshingBatch)" @onclick="PreviousBatchItemPageAsync">Previous</button>
                        <button class="btn btn-sm btn-outline-secondary" disabled="@(batchItemPage >= BatchItemTotalPages || refreshingBatch)" @onclick="NextBatchItemPageAsync">Next</button>
                    </div>
                </div>
            }
        </section>
    }

    <section class="panel panel-flush" aria-labelledby="version-batches-heading">
        <div class="section-heading px-3 pt-3">
            <div><h2 id="version-batches-heading">Recent batches</h2><p>Prepared and executed version changes are retained and can be reopened.</p></div>
            <select class="form-select version-status-filter" value="@batchListStatus" @onchange="OnBatchListStatusChangedAsync" aria-label="Filter batches by status">
                @foreach (var option in BatchStatusOptions) { <option value="@option.Value">@option.Label</option> }
            </select>
        </div>
        @if (batchList is null)
        {
            <div class="p-3"><div class="skeleton" role="status"></div></div>
        }
        else if (batchList.Items.Count == 0)
        {
            <div class="px-3 pb-3"><EmptyState Icon="instances" Title="No version-change batches" Description="No batch matches the selected status." /></div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table align-middle">
                    <thead><tr><th>Batch</th><th>Workflow</th><th>Change</th><th>Prepared by</th><th>Progress</th><th>Status</th><th>Updated</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var item in batchList.Items)
                        {
                            <tr class="@(currentBatch?.Summary.Id == item.Id ? "table-active" : null)">
                                <td>#@item.Id</td>
                                <td>@item.SourceWorkflow.Name<span class="data-subtitle">@item.SourceWorkflow.WorkflowKey</span></td>
                                <td>v@(item.SourceWorkflow.Version) → v@(item.TargetWorkflow.Version)<span class="data-subtitle">@item.Direction</span></td>
                                <td>@item.PreparedBy</td>
                                <td>@item.SucceededItemCount.ToString("N0") / @item.TotalItemCount.ToString("N0")<span class="data-subtitle">@item.EligibleItemCount.ToString("N0") eligible · @item.BlockedItemCount.ToString("N0") blocked · @item.StaleItemCount.ToString("N0") stale</span></td>
                                <td><StatusBadge Status="@item.Status" /></td>
                                <td>@item.UpdatedAt.ToLocalTime().ToString("g")</td>
                                <td class="text-end"><button class="btn btn-sm btn-outline-primary" @onclick="() => OpenBatchAsync(item.Id)">Open</button></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="pagination-bar">
                <span class="pagination-copy">Page @batchListPage of @BatchListTotalPages · @batchList.TotalCount.ToString("N0") batches</span>
                <div class="d-flex gap-2">
                    <button class="btn btn-sm btn-outline-secondary" disabled="@(batchListPage <= 1 || loadingBatches)" @onclick="PreviousBatchListPageAsync">Previous</button>
                    <button class="btn btn-sm btn-outline-secondary" disabled="@(batchListPage >= BatchListTotalPages || loadingBatches)" @onclick="NextBatchListPageAsync">Next</button>
                </div>
            </div>
        }
    </section>
}

@code {
    [SupplyParameterFromQuery(Name = "batchId")]
    public long? RequestedBatchId { get; set; }

    private const int CandidatePageSize = 50;
    private const int BatchListPageSize = 25;
    private const int BatchItemPageSize = 50;
    private const int MaxBatchInstances = 10_000;
    private static readonly JsonSerializerOptions JsonOptions = new(JsonSerializerDefaults.Web) { WriteIndented = true };
    private static readonly (string Value, string Label)[] BatchStatusOptions =
    [
        ("", "All statuses"), ("preparing", "Preparing"), ("ready", "Ready"), ("queued", "Queued"),
        ("running", "Running"), ("completed", "Completed"), ("completedWithIssues", "Completed with issues"),
        ("cancelled", "Cancelled"), ("failed", "Failed")
    ];
    private static readonly (string Value, string Label)[] BatchItemStatusOptions =
    [
        ("", "All item statuses"), ("preparing", "Preparing"), ("eligible", "Eligible"),
        ("ineligible", "Ineligible"), ("queued", "Queued"), ("succeeded", "Succeeded"),
        ("skipped", "Skipped"), ("failed", "Failed"), ("cancelled", "Cancelled")
    ];

    private IReadOnlyList<WorkflowSummaryDto>? workflowFamilies;
    private IReadOnlyList<WorkflowSummaryDto> workflowVersions = [];
    private string? selectedWorkflowKey;
    private long? selectedSourceWorkflowId;
    private long? selectedTargetWorkflowId;
    private long? candidateInstanceId;
    private string? candidateBusinessKey;
    private int? candidateNodeId;
    private string? candidateNodeExternalId;
    private string? candidateVariableFilterJson;
    private string? candidateVariableFilterError;
    private bool includeVariables;
    private bool appliedIncludeVariables;
    private PagedResult<InstanceVersionChangeCandidateDto>? candidates;
    private InstanceVersionChangeCandidateFilterDto? appliedCandidateFilter;
    private readonly HashSet<long> explicitlySelectedInstances = [];
    private readonly HashSet<long> excludedInstances = [];
    private bool allMatchingSelection;
    private int candidatePage = 1;
    private bool candidateFiltersDirty;
    private string reason = string.Empty;
    private string? draftIdempotencyKey;
    private InstanceVersionChangeBatchDetailDto? currentBatch;
    private PagedResult<InstanceVersionChangeBatchItemDto>? batchItems;
    private string? batchItemStatus;
    private int batchItemPage = 1;
    private PagedResult<InstanceVersionChangeBatchSummaryDto>? batchList;
    private string? batchListStatus;
    private int batchListPage = 1;
    private string? cancellationReason;
    private string? error;
    private string? success;
    private bool loading;
    private bool loadingDefinition;
    private bool candidateLoading;
    private bool batchOperation;
    private bool refreshingBatch;
    private bool loadingBatches;
    private readonly CancellationTokenSource pollCancellation = new();
    private Task? pollTask;

    private string SelectedSourceWorkflowIdText => selectedSourceWorkflowId?.ToString() ?? string.Empty;
    private string SelectedTargetWorkflowIdText => selectedTargetWorkflowId?.ToString() ?? string.Empty;
    private WorkflowSummaryDto? SelectedSourceWorkflow => workflowVersions.FirstOrDefault(version => version.Id == selectedSourceWorkflowId);
    private WorkflowSummaryDto? SelectedTargetWorkflow => workflowVersions.FirstOrDefault(version => version.Id == selectedTargetWorkflowId);
    private IReadOnlyList<WorkflowSummaryDto> TargetVersions => workflowVersions
        .Where(version => version.IsPublished && version.Id != selectedSourceWorkflowId)
        .OrderByDescending(version => version.Version)
        .ThenByDescending(version => version.Id)
        .ToArray();
    private bool CanSearchCandidates => !candidateLoading && selectedSourceWorkflowId is > 0 && selectedTargetWorkflowId is > 0;
    private long SelectedCandidateCount => allMatchingSelection
        ? Math.Max(0, (candidates?.TotalCount ?? 0) - excludedInstances.Count)
        : explicitlySelectedInstances.Count;
    private int ReasonLength => reason.Trim().EnumerateRunes().Count();
    private bool HasValidReason => ReasonLength is >= 1 and <= 1000;
    private bool CanCreateBatch => !batchOperation && !candidateFiltersDirty
        && selectedSourceWorkflowId is > 0 && selectedTargetWorkflowId is > 0
        && appliedCandidateFilter is not null
        && SelectedCandidateCount is > 0 and <= MaxBatchInstances
        && HasValidReason;
    private int CandidateTotalPages => TotalPages(candidates?.TotalCount ?? 0, CandidatePageSize);
    private int BatchItemTotalPages => TotalPages(batchItems?.TotalCount ?? 0, BatchItemPageSize);
    private int BatchListTotalPages => TotalPages(batchList?.TotalCount ?? 0, BatchListPageSize);
    private bool CanConfirmCurrentBatch => currentBatch?.Summary.Status.Equals("ready", StringComparison.OrdinalIgnoreCase) == true
        && currentBatch.Summary.EligibleItemCount > 0;
    private bool CanCancelCurrentBatch => currentBatch is not null && IsCancellable(currentBatch.Summary.Status);
    private string CandidateSummary => candidateFiltersDirty
        ? "Filters changed. Search again to establish a new server-side result."
        : candidateLoading ? "Searching running instances…"
        : candidates is null ? "No search has run yet."
        : $"{candidates.TotalCount:N0} running instance(s)";

    protected override async Task OnInitializedAsync()
    {
        Token.Changed += OnTokenChanged;
        pollTask = PollCurrentBatchAsync(pollCancellation.Token);
        if (Token.HasToken) await LoadInitialAsync();
    }

    private async Task LoadInitialAsync()
    {
        try
        {
            loading = true;
            error = null;
            workflowFamilies = (await Api.GetWorkflowsAsync())
                .OrderBy(workflow => workflow.Name, StringComparer.OrdinalIgnoreCase)
                .ThenBy(workflow => workflow.WorkflowKey, StringComparer.OrdinalIgnoreCase)
                .ToArray();
            selectedWorkflowKey = workflowFamilies.FirstOrDefault()?.WorkflowKey;
            if (!string.IsNullOrWhiteSpace(selectedWorkflowKey)) await LoadWorkflowFamilyAsync(selectedWorkflowKey);
            await LoadBatchListAsync();
            if (RequestedBatchId is > 0) await OpenBatchAsync(RequestedBatchId.Value);
        }
        catch (Exception ex)
        {
            error = ex.Message;
            workflowFamilies ??= [];
        }
        finally { loading = false; }
    }

    private async Task RefreshAllAsync()
    {
        if (!Token.HasToken) return;
        var openedBatchId = currentBatch?.Summary.Id;
        await LoadInitialAsync();
        if (openedBatchId is long batchId) await OpenBatchAsync(batchId);
    }

    private async Task OnWorkflowFamilyChangedAsync(ChangeEventArgs args)
    {
        selectedWorkflowKey = args.Value?.ToString();
        if (!string.IsNullOrWhiteSpace(selectedWorkflowKey)) await LoadWorkflowFamilyAsync(selectedWorkflowKey);
    }

    private async Task LoadWorkflowFamilyAsync(string workflowKey)
    {
        try
        {
            loadingDefinition = true;
            error = null;
            workflowVersions = (await Api.GetWorkflowVersionsAsync(workflowKey))
                .OrderByDescending(version => version.Version)
                .ThenByDescending(version => version.Id)
                .ToArray();
            selectedSourceWorkflowId = workflowVersions.FirstOrDefault()?.Id;
            SelectDefaultTarget();
        }
        catch (Exception ex)
        {
            error = ex.Message;
            workflowVersions = [];
            selectedSourceWorkflowId = null;
            selectedTargetWorkflowId = null;
        }
        finally
        {
            loadingDefinition = false;
            ResetCandidateResults();
        }
    }

    private Task OnSourceWorkflowChangedAsync(ChangeEventArgs args)
    {
        selectedSourceWorkflowId = long.TryParse(args.Value?.ToString(), out var id) && id > 0 ? id : null;
        SelectDefaultTarget();
        ResetCandidateResults();
        return Task.CompletedTask;
    }

    private void SelectDefaultTarget()
    {
        if (selectedTargetWorkflowId is not long current || TargetVersions.All(version => version.Id != current))
        {
            selectedTargetWorkflowId = TargetVersions.FirstOrDefault()?.Id;
        }
        draftIdempotencyKey = null;
    }

    private void OnTargetWorkflowChanged(ChangeEventArgs args)
    {
        selectedTargetWorkflowId = long.TryParse(args.Value?.ToString(), out var id) && id > 0 ? id : null;
        draftIdempotencyKey = null;
    }

    private string VersionDirectionLabel(WorkflowSummaryDto target) =>
        SelectedSourceWorkflow is { } source && target.Version > source.Version ? "Upgrade" : "Downgrade";

    private void InvalidateCandidateSearch()
    {
        if (candidates is not null) candidateFiltersDirty = true;
        candidatePage = 1;
        ClearSelection();
    }

    private void OnCandidateInstanceIdInput(ChangeEventArgs args)
    {
        candidateInstanceId = long.TryParse(args.Value?.ToString(), out var value)
            ? value
            : null;
        InvalidateCandidateSearch();
    }

    private void OnCandidateBusinessKeyInput(ChangeEventArgs args)
    {
        candidateBusinessKey = args.Value?.ToString();
        InvalidateCandidateSearch();
    }

    private void OnCandidateNodeIdInput(ChangeEventArgs args)
    {
        candidateNodeId = int.TryParse(args.Value?.ToString(), out var value)
            ? value
            : null;
        InvalidateCandidateSearch();
    }

    private void OnCandidateNodeExternalIdInput(ChangeEventArgs args)
    {
        candidateNodeExternalId = args.Value?.ToString();
        InvalidateCandidateSearch();
    }

    private Task OnCandidateVariableFilterChanged(string? value)
    {
        candidateVariableFilterJson = value;
        candidateVariableFilterError = null;
        InvalidateCandidateSearch();
        return Task.CompletedTask;
    }

    private void OnIncludeVariablesChanged(ChangeEventArgs args)
    {
        includeVariables = args.Value is true;
        InvalidateCandidateSearch();
    }

    private async Task ClearCandidateFiltersAsync()
    {
        candidateInstanceId = null;
        candidateBusinessKey = null;
        candidateNodeId = null;
        candidateNodeExternalId = null;
        candidateVariableFilterJson = null;
        candidateVariableFilterError = null;
        includeVariables = false;
        candidatePage = 1;
        await SearchCandidatesAsync();
    }

    private async Task SearchCandidatesAsync()
    {
        if (!CanSearchCandidates || selectedSourceWorkflowId is not long sourceWorkflowId) return;
        if (!AdvancedVariableFilterInput.TryParse(candidateVariableFilterJson, out JsonElement? variableFilter, out candidateVariableFilterError)) return;
        try
        {
            candidateLoading = true;
            error = null;
            success = null;
            appliedCandidateFilter = new InstanceVersionChangeCandidateFilterDto
            {
                SourceWorkflowId = sourceWorkflowId,
                InstanceId = candidateInstanceId,
                BusinessKey = string.IsNullOrWhiteSpace(candidateBusinessKey) ? null : candidateBusinessKey.Trim(),
                NodeId = candidateNodeId,
                NodeExternalId = string.IsNullOrWhiteSpace(candidateNodeExternalId) ? null : candidateNodeExternalId.Trim(),
                VariableFilter = variableFilter
            };
            appliedIncludeVariables = includeVariables;
            candidatePage = 1;
            candidates = await Api.SearchInstanceVersionChangeCandidatesAsync(new InstanceVersionChangeCandidateSearchRequest
            {
                Filter = appliedCandidateFilter,
                IncludeVariables = appliedIncludeVariables,
                Page = candidatePage,
                PageSize = CandidatePageSize
            });
            candidateFiltersDirty = false;
            ClearSelection();
        }
        catch (Exception ex)
        {
            error = ex.Message;
            candidates = null;
            appliedCandidateFilter = null;
        }
        finally { candidateLoading = false; }
    }

    private async Task LoadCandidatePageAsync(int page)
    {
        if (appliedCandidateFilter is null) return;
        try
        {
            candidateLoading = true;
            candidatePage = page;
            candidates = await Api.SearchInstanceVersionChangeCandidatesAsync(new InstanceVersionChangeCandidateSearchRequest
            {
                Filter = appliedCandidateFilter,
                IncludeVariables = appliedIncludeVariables,
                Page = candidatePage,
                PageSize = CandidatePageSize
            });
        }
        catch (Exception ex) { error = ex.Message; }
        finally { candidateLoading = false; }
    }

    private Task PreviousCandidatePageAsync() => LoadCandidatePageAsync(Math.Max(1, candidatePage - 1));
    private Task NextCandidatePageAsync() => LoadCandidatePageAsync(Math.Min(CandidateTotalPages, candidatePage + 1));

    private bool IsCandidateSelected(long instanceId) => allMatchingSelection
        ? !excludedInstances.Contains(instanceId)
        : explicitlySelectedInstances.Contains(instanceId);

    private void ToggleCandidate(long instanceId)
    {
        if (allMatchingSelection)
        {
            if (!excludedInstances.Add(instanceId)) excludedInstances.Remove(instanceId);
        }
        else if (!explicitlySelectedInstances.Add(instanceId)) explicitlySelectedInstances.Remove(instanceId);
        draftIdempotencyKey = null;
    }

    private void SelectCurrentCandidatePage()
    {
        if (candidates is null) return;
        if (allMatchingSelection)
        {
            foreach (var candidate in candidates.Items) excludedInstances.Remove(candidate.InstanceId);
        }
        else
        {
            foreach (var candidate in candidates.Items) explicitlySelectedInstances.Add(candidate.InstanceId);
        }
        draftIdempotencyKey = null;
    }

    private void SetSelectionMode(bool allMatching)
    {
        allMatchingSelection = allMatching;
        explicitlySelectedInstances.Clear();
        excludedInstances.Clear();
        draftIdempotencyKey = null;
    }

    private void ClearSelection()
    {
        explicitlySelectedInstances.Clear();
        excludedInstances.Clear();
        draftIdempotencyKey = null;
    }

    private void OnReasonChanged(ChangeEventArgs args)
    {
        reason = args.Value?.ToString() ?? string.Empty;
        draftIdempotencyKey = null;
    }

    private async Task CreateBatchAsync()
    {
        if (!CanCreateBatch || appliedCandidateFilter is null
            || selectedSourceWorkflowId is not long sourceWorkflowId
            || selectedTargetWorkflowId is not long targetWorkflowId) return;
        try
        {
            batchOperation = true;
            error = null;
            success = null;
            draftIdempotencyKey ??= Guid.NewGuid().ToString("N");
            var selection = allMatchingSelection
                ? new InstanceVersionChangeBatchSelectionDto(
                    InstanceVersionChangeBatchSelectionModes.AllMatching,
                    null,
                    appliedCandidateFilter,
                    excludedInstances.Order().ToArray())
                : new InstanceVersionChangeBatchSelectionDto(
                    InstanceVersionChangeBatchSelectionModes.Explicit,
                    explicitlySelectedInstances.Order().ToArray(),
                    null,
                    null);
            currentBatch = await Api.CreateInstanceVersionChangeBatchAsync(new CreateInstanceVersionChangeBatchRequest(
                sourceWorkflowId,
                targetWorkflowId,
                reason.Trim(),
                selection,
                draftIdempotencyKey));
            draftIdempotencyKey = null;
            batchItemPage = 1;
            batchItemStatus = null;
            await LoadBatchItemsAsync();
            await LoadBatchListAsync();
            success = $"Batch #{currentBatch.Summary.Id} was frozen and queued for asynchronous compatibility preparation.";
        }
        catch (Exception ex) { error = ex.Message; }
        finally { batchOperation = false; }
    }

    private async Task OpenBatchAsync(long batchId)
    {
        try
        {
            error = null;
            currentBatch = await Api.GetInstanceVersionChangeBatchAsync(batchId)
                ?? throw new InvalidOperationException($"Instance version-change batch #{batchId} was not found.");
            batchItemPage = 1;
            batchItemStatus = null;
            cancellationReason = null;
            await LoadBatchItemsAsync();
        }
        catch (Exception ex) { error = ex.Message; }
    }

    private async Task RefreshCurrentBatchAsync()
    {
        if (currentBatch is null || refreshingBatch) return;
        try
        {
            refreshingBatch = true;
            var refreshed = await Api.GetInstanceVersionChangeBatchAsync(currentBatch.Summary.Id);
            if (refreshed is not null) currentBatch = refreshed;
            await LoadBatchItemsAsync();
            await LoadBatchListAsync();
        }
        catch (Exception ex) { error = ex.Message; }
        finally { refreshingBatch = false; }
    }

    private async Task ConfirmCurrentBatchAsync()
    {
        if (!CanConfirmCurrentBatch || currentBatch is null) return;
        try
        {
            batchOperation = true;
            error = null;
            var expected = currentBatch.Summary;
            currentBatch = await Api.ConfirmInstanceVersionChangeBatchAsync(expected.Id,
                new ConfirmInstanceVersionChangeBatchRequest(
                    expected.EligibleItemCount,
                    expected.IneligibleItemCount,
                    expected.WarningItemCount,
                    expected.UpdatedAt));
            success = $"Batch #{expected.Id} was confirmed. Eligible instances are queued for independent version changes.";
            await LoadBatchItemsAsync();
            await LoadBatchListAsync();
        }
        catch (Exception ex) { error = ex.Message; }
        finally { batchOperation = false; }
    }

    private async Task CancelCurrentBatchAsync()
    {
        if (!CanCancelCurrentBatch || currentBatch is null) return;
        try
        {
            batchOperation = true;
            error = null;
            var id = currentBatch.Summary.Id;
            currentBatch = await Api.CancelInstanceVersionChangeBatchAsync(id,
                new CancelInstanceVersionChangeBatchRequest(string.IsNullOrWhiteSpace(cancellationReason) ? null : cancellationReason.Trim()));
            success = $"Batch #{id} was cancelled. Completed version changes were not reversed.";
            await LoadBatchItemsAsync();
            await LoadBatchListAsync();
        }
        catch (Exception ex) { error = ex.Message; }
        finally { batchOperation = false; }
    }

    private async Task LoadBatchItemsAsync()
    {
        if (currentBatch is null) return;
        batchItems = await Api.GetInstanceVersionChangeBatchItemsAsync(currentBatch.Summary.Id, batchItemStatus, batchItemPage, BatchItemPageSize);
    }

    private async Task OnBatchItemStatusChangedAsync(ChangeEventArgs args)
    {
        batchItemStatus = args.Value?.ToString();
        batchItemPage = 1;
        await LoadBatchItemsAsync();
    }

    private async Task PreviousBatchItemPageAsync() { batchItemPage = Math.Max(1, batchItemPage - 1); await LoadBatchItemsAsync(); }
    private async Task NextBatchItemPageAsync() { batchItemPage = Math.Min(BatchItemTotalPages, batchItemPage + 1); await LoadBatchItemsAsync(); }

    private async Task LoadBatchListAsync()
    {
        try
        {
            loadingBatches = true;
            batchList = await Api.GetInstanceVersionChangeBatchesAsync(new InstanceVersionChangeBatchSearchRequest
            {
                Status = string.IsNullOrWhiteSpace(batchListStatus) ? null : batchListStatus,
                Page = batchListPage,
                PageSize = BatchListPageSize
            });
        }
        finally { loadingBatches = false; }
    }

    private async Task OnBatchListStatusChangedAsync(ChangeEventArgs args)
    {
        batchListStatus = args.Value?.ToString();
        batchListPage = 1;
        await LoadBatchListAsync();
    }

    private async Task PreviousBatchListPageAsync() { batchListPage = Math.Max(1, batchListPage - 1); await LoadBatchListAsync(); }
    private async Task NextBatchListPageAsync() { batchListPage = Math.Min(BatchListTotalPages, batchListPage + 1); await LoadBatchListAsync(); }

    private async Task PollCurrentBatchAsync(CancellationToken cancellationToken)
    {
        try
        {
            using var timer = new PeriodicTimer(TimeSpan.FromSeconds(3));
            while (await timer.WaitForNextTickAsync(cancellationToken))
            {
                if (currentBatch is null || !IsLive(currentBatch.Summary) || refreshingBatch) continue;
                await InvokeAsync(RefreshCurrentBatchAsync);
            }
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested) { }
    }

    private void OnTokenChanged() => _ = InvokeAsync(async () =>
    {
        if (Token.HasToken) await LoadInitialAsync();
        else
        {
            workflowFamilies = null;
            currentBatch = null;
            batchList = null;
        }
        StateHasChanged();
    });

    private void ResetCandidateResults()
    {
        candidates = null;
        appliedCandidateFilter = null;
        candidatePage = 1;
        candidateFiltersDirty = false;
        appliedIncludeVariables = false;
        ClearSelection();
    }

    private RenderFragment BatchItemResult(InstanceVersionChangeBatchItemDto item) => @<div>
        @if (!string.IsNullOrWhiteSpace(item.ErrorDescription))
        {
            <span class="text-danger">@item.ErrorDescription</span>
        }
        @if (item.Blockers.Count > 0)
        {
            <details><summary class="section-link">@item.Blockers.Count blocker(s)</summary><ul class="version-issue-list">@foreach (var issue in item.Blockers) { <li><strong>@issue.Code:</strong> @issue.Message@IssueLocation(issue)</li> }</ul></details>
        }
        @if (item.Warnings.Count > 0)
        {
            <details><summary class="section-link">@item.Warnings.Count warning(s)</summary><ul class="version-issue-list">@foreach (var issue in item.Warnings) { <li><strong>@issue.Code:</strong> @issue.Message@IssueLocation(issue)</li> }</ul></details>
        }
        @if (item.VersionChangeAuditId is long auditId)
        {
            <a class="section-link" href="@($"instances/{item.InstanceId}#version-changes")">Version-change audit #@auditId</a>
        }
        @if (item.Result is JsonElement result)
        {
            <details><summary class="section-link">Execution result</summary><pre class="version-change-json mt-2">@FormatJson(result)</pre></details>
        }
        @if (string.IsNullOrWhiteSpace(item.ErrorDescription) && item.Blockers.Count == 0 && item.Warnings.Count == 0 && item.VersionChangeAuditId is null && item.Result is null)
        {
            <span class="text-muted">—</span>
        }
    </div>;

    private static string IssueLocation(InstanceVersionChangeIssueDto issue)
    {
        var parts = new List<string>();
        if (!string.IsNullOrWhiteSpace(issue.StateType)) parts.Add(issue.StateId is long stateId ? $"{issue.StateType} #{stateId}" : issue.StateType);
        if (issue.NodeId is int nodeId) parts.Add($"node #{nodeId}");
        if (issue.FlowId is int flowId) parts.Add($"flow #{flowId}");
        if (!string.IsNullOrWhiteSpace(issue.VariableName)) parts.Add($"variable '{issue.VariableName}'");
        return parts.Count == 0 ? string.Empty : $" ({string.Join(", ", parts)})";
    }

    private static string RoleSnapshot(IReadOnlyList<string>? roles) => roles is null || roles.Count == 0 ? "no roles" : string.Join(", ", roles);
    private static string FormatJson(JsonElement value) => JsonSerializer.Serialize(value, JsonOptions);
    private static int TotalPages(long totalCount, int pageSize) => totalCount == 0 ? 1 : (int)Math.Ceiling(totalCount / (double)pageSize);
    private static bool IsCancellable(string status) => status.Equals("preparing", StringComparison.OrdinalIgnoreCase)
        || status.Equals("ready", StringComparison.OrdinalIgnoreCase)
        || status.Equals("queued", StringComparison.OrdinalIgnoreCase)
        || status.Equals("running", StringComparison.OrdinalIgnoreCase);
    private static bool IsLive(InstanceVersionChangeBatchSummaryDto summary) =>
        summary.Status.Equals("preparing", StringComparison.OrdinalIgnoreCase)
        || summary.Status.Equals("queued", StringComparison.OrdinalIgnoreCase)
        || summary.Status.Equals("running", StringComparison.OrdinalIgnoreCase)
        || (summary.Status.Equals("cancelled", StringComparison.OrdinalIgnoreCase) && summary.CompletedAt is null);

    public async ValueTask DisposeAsync()
    {
        Token.Changed -= OnTokenChanged;
        await pollCancellation.CancelAsync();
        if (pollTask is not null)
        {
            try { await pollTask; }
            catch (OperationCanceledException) { }
        }
        pollCancellation.Dispose();
    }
}
