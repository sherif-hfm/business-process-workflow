@page "/instance-variable-updates"
@implements IAsyncDisposable
@using System.Text.Json
@using Flowbit.Ui.Auth
@inject WorkflowApiClient Api
@inject TokenState Token

<PageTitle>Instance variable updates - Flowbit</PageTitle>

<PageHeader Eyebrow="Manage" Title="Administrative instance variables"
            Description="Freeze running instances, review the population, then add or overwrite raw JSON variables asynchronously.">
    <Actions>
        <a class="btn btn-outline-secondary" href="instances"><AppIcon Name="instances" /> Instances</a>
        <button class="btn btn-outline-secondary" @onclick="RefreshAllAsync" disabled="@loading"><AppIcon Name="refresh" /> Refresh</button>
    </Actions>
</PageHeader>

<div class="alert alert-warning variable-update-warning" role="note">
    <strong>Administrative values bypass workflow variable declarations and validation.</strong>
    They can change later routing. JSON <code>null</code> stores a value; it does not delete a variable. Active jobs are reported as warnings because they may already hold frozen state.
</div>

@if (!string.IsNullOrWhiteSpace(error))
{
    <div class="alert alert-danger" role="alert">@error</div>
}
@if (!string.IsNullOrWhiteSpace(success))
{
    <div class="alert alert-success" role="status">@success</div>
}

@if (!Token.HasToken)
{
    <section class="panel">
        <EmptyState Icon="token" Title="An authenticated identity is required"
                    Description="Set a test identity with the configured Workflow.RequiredRole before updating instance variables.">
            <a class="btn btn-primary" href="token">Set test identity</a>
        </EmptyState>
    </section>
}
else
{
    <section class="panel mb-3" aria-labelledby="variable-update-definition-heading">
        <div class="section-heading">
            <div>
                <h2 id="variable-update-definition-heading">1. Choose a workflow family</h2>
                <p>Search every version in one family, or constrain the candidate population to one exact immutable definition.</p>
            </div>
        </div>

        @if (workflowFamilies is null)
        {
            <div class="skeleton" role="status"></div>
        }
        else if (workflowFamilies.Count == 0)
        {
            <EmptyState Icon="workflows" Title="No workflow definitions" Description="No workflow family is available to the current identity." />
        }
        else
        {
            <div class="variable-definition-grid">
                <div>
                    <label class="form-label" for="variable-update-family">Workflow family <span class="required-mark">*</span></label>
                    <select id="variable-update-family" class="form-select" value="@selectedWorkflowKey"
                            @onchange="OnWorkflowFamilyChangedAsync" disabled="@loadingDefinition">
                        @foreach (var workflow in workflowFamilies)
                        {
                            <option value="@workflow.WorkflowKey">@workflow.Name (@workflow.WorkflowKey)</option>
                        }
                    </select>
                </div>
                <div>
                    <label class="form-label" for="variable-update-version">Workflow version</label>
                    <select id="variable-update-version" class="form-select" value="@SelectedWorkflowDefinitionIdText"
                            @onchange="OnWorkflowVersionChanged" disabled="@loadingDefinition">
                        <option value="">All versions in this family</option>
                        @foreach (var version in workflowVersions)
                        {
                            <option value="@version.Id">v@(version.Version) - definition #@version.Id@(version.IsPublished ? " - published" : " - unpublished")</option>
                        }
                    </select>
                </div>
            </div>
            @if (loadingDefinition)
            {
                <div class="skeleton mt-3" role="status"></div>
            }
        }
    </section>

    <section class="filter-panel mb-3" aria-labelledby="variable-update-search-heading">
        <div class="section-heading">
            <div>
                <h2 id="variable-update-search-heading">2. Search running instances</h2>
                <p>The selected workflow family and running status are always enforced by the server.</p>
            </div>
        </div>
        <div class="filter-grid">
            <div><label class="form-label" for="variable-update-instance-id">Instance ID</label><input id="variable-update-instance-id" type="number" class="form-control" value="@candidateInstanceId" @oninput="OnCandidateInstanceIdInput" /></div>
            <div><label class="form-label" for="variable-update-business-key">Business key</label><input id="variable-update-business-key" class="form-control" value="@candidateBusinessKey" @oninput="OnCandidateBusinessKeyInput" /></div>
            <div><label class="form-label" for="variable-update-node-id">Current node ID</label><input id="variable-update-node-id" type="number" class="form-control" value="@candidateNodeId" @oninput="OnCandidateNodeIdInput" /></div>
            <div><label class="form-label" for="variable-update-node-external-id">Current node external ID</label><input id="variable-update-node-external-id" class="form-control" value="@candidateNodeExternalId" @oninput="OnCandidateNodeExternalIdInput" /></div>
            <div class="filter-span-2">
                <AdvancedVariableFilterEditor Id="variable-update-filter"
                                              Label="Advanced current-variable filter (JSON)"
                                              Value="@candidateVariableFilterJson"
                                              ValueChanged="OnCandidateVariableFilterChanged"
                                              Error="@candidateVariableFilterError" />
            </div>
            <div class="form-check align-self-center">
                <input id="variable-update-include-variables" class="form-check-input" type="checkbox" checked="@includeVariables"
                       @onchange="OnIncludeVariablesChanged" @onchange:stopPropagation="true" />
                <label class="form-check-label" for="variable-update-include-variables">Include variables in results</label>
            </div>
            <div class="filter-actions">
                <button class="btn btn-primary" @onclick="SearchCandidatesAsync" disabled="@(!CanSearchCandidates)"><AppIcon Name="search" /> Search instances</button>
                <button class="btn btn-outline-secondary" @onclick="ClearCandidateFiltersAsync" disabled="@candidateLoading">Clear filters</button>
            </div>
        </div>
        <div class="mt-3">
            <SortToolbar Id="variable-update-sort"
                         Options="CandidateSortOptions"
                         DefaultField="updatedAt"
                         DefaultDirection="desc"
                         Applied="ApplyCandidateSortAsync" />
        </div>
    </section>

    <section class="panel panel-flush mb-3" aria-labelledby="variable-update-candidates-heading">
        <div class="section-heading px-3 pt-3">
            <div>
                <h2 id="variable-update-candidates-heading">3. Select the frozen population</h2>
                <p>@CandidateSummary</p>
            </div>
            @if (candidates is not null && candidates.TotalCount > 0 && !candidateFiltersDirty)
            {
                <div class="d-flex flex-wrap gap-2">
                    <button class="btn btn-sm btn-outline-secondary" @onclick="SelectCurrentCandidatePage">Select this page</button>
                    <button class="btn btn-sm btn-outline-secondary" @onclick="ClearSelection">@(allMatchingSelection ? "Clear exclusions" : "Clear selection")</button>
                </div>
            }
        </div>

        @if (candidateFiltersDirty)
        {
            <EmptyState Icon="search" Title="Search the changed filters" Description="The prior result and selection will not be used for batch preparation." />
        }
        else if (candidateLoading)
        {
            <div class="p-3"><div class="skeleton" role="status"></div></div>
        }
        else if (candidates is null)
        {
            <EmptyState Icon="search" Title="Search for instances" Description="Choose a workflow family and run a search." />
        }
        else if (candidates.Items.Count == 0)
        {
            <EmptyState Icon="instances" Title="No running instances" Description="No running instance matches the applied family and filters." />
        }
        else
        {
            <div class="px-3 pb-3">
                <div class="variable-selection-mode-grid mb-3">
                    <label class="variable-selection-mode-card">
                        <input type="radio" name="variable-selection-mode" checked="@(!allMatchingSelection)" @onchange="_ => SetSelectionMode(false)" />
                        <span><strong>Explicit instances</strong><small>Freeze only checked instance IDs across visited pages.</small></span>
                    </label>
                    <label class="variable-selection-mode-card">
                        <input type="radio" name="variable-selection-mode" checked="@allMatchingSelection" @onchange="_ => SetSelectionMode(true)" />
                        <span><strong>All @candidates.TotalCount.ToString("N0") matching</strong><small>Freeze the applied server-side filter except unchecked exclusions.</small></span>
                    </label>
                </div>
                <div class="alert @(SelectedCandidateCount > MaxBatchInstances || ExpandedWriteCount > MaxExpandedWrites ? "alert-danger" : "alert-info") py-2 mb-0">
                    Selected instances: <strong>@SelectedCandidateCount.ToString("N0")</strong>; expanded writes: <strong>@ExpandedWriteCount.ToString("N0")</strong>.
                    Maximums are @MaxBatchInstances.ToString("N0") instances and @MaxExpandedWrites.ToString("N0") expanded writes.
                </div>
            </div>

            <div class="table-responsive">
                <table class="table align-middle">
                    <caption class="visually-hidden">Running workflow instances available for variable update</caption>
                    <thead><tr><th><span class="visually-hidden">Select</span></th><th>Instance</th><th>Workflow</th><th>Execution positions</th><th>Active jobs</th>@if (appliedIncludeVariables) { <th>Variables</th> }<th>Updated</th></tr></thead>
                    <tbody>
                        @foreach (var candidate in candidates.Items)
                        {
                            <tr>
                                <td><input class="form-check-input" type="checkbox" aria-label="Select instance @candidate.InstanceId" checked="@IsCandidateSelected(candidate.InstanceId)" @onchange="_ => ToggleCandidate(candidate.InstanceId)" /></td>
                                <td><a class="data-title" href="@($"instances/{candidate.InstanceId}")">Instance #@candidate.InstanceId</a><span class="data-subtitle">@(candidate.BusinessKey ?? "No business key")</span></td>
                                <td>@candidate.WorkflowName<span class="data-subtitle">v@(candidate.WorkflowVersion) - definition #@candidate.WorkflowDefinitionId</span></td>
                                <td><ExecutionPositionList Positions="@candidate.ExecutionPositions" Compact="true" MaxItems="3" /></td>
                                <td>@if (candidate.Jobs is { } jobs) { <span>@jobs.OpenCount open</span><span class="data-subtitle">@jobs.RunningCount running - @jobs.IncidentCount incident</span> } else { <span class="text-muted">-</span> }</td>
                                @if (appliedIncludeVariables)
                                {
                                    <td><VariableValues Values="@candidate.Variables" /></td>
                                }
                                <td>@candidate.UpdatedAt.ToLocalTime().ToString("g")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="pagination-bar">
                <span class="pagination-copy">Page @candidatePage - @candidates.TotalCount.ToString("N0") total</span>
                <div class="d-flex gap-2">
                    <button class="btn btn-sm btn-outline-secondary" disabled="@(candidateLoading || candidatePage <= 1)" @onclick="PreviousCandidatePageAsync">Previous</button>
                    <button class="btn btn-sm btn-outline-secondary" disabled="@(candidateLoading || string.IsNullOrWhiteSpace(candidates.NextCursor))" @onclick="NextCandidatePageAsync">Next</button>
                </div>
            </div>
        }
    </section>

    <section class="panel mb-3" aria-labelledby="variable-update-values-heading">
        <div class="section-heading">
            <div>
                <h2 id="variable-update-values-heading">4. Enter raw JSON variables and prepare</h2>
                <p>The same literal values are applied atomically within each selected instance. Existing names are overwritten; new names are added.</p>
            </div>
            <button class="btn btn-sm btn-outline-primary" @onclick="AddVariableRow" disabled="@(variableRows.Count >= InstanceVariableUpdateInputParser.MaxVariableCount)"><AppIcon Name="plus" /> Add variable</button>
        </div>

        <div class="variable-row-list">
            @foreach (var row in variableRows)
            {
                <div class="variable-write-row" @key="row.Id">
                    <div>
                        <label class="form-label" for="@($"variable-name-{row.Id}")">Name <span class="required-mark">*</span></label>
                        <input id="@($"variable-name-{row.Id}")" class="form-control @(row.NameError is null ? null : "is-invalid")" value="@row.Name"
                               @oninput="args => OnVariableNameChanged(row, args)" maxlength="340" placeholder="approvalNote" />
                        @if (row.NameError is not null) { <div class="invalid-feedback">@row.NameError</div> }
                    </div>
                    <div>
                        <label class="form-label" for="@($"variable-value-{row.Id}")">Raw JSON value <span class="required-mark">*</span></label>
                        <textarea id="@($"variable-value-{row.Id}")" class="form-control variable-json-input @(row.ValueError is null ? null : "is-invalid")" rows="3" value="@row.RawValue"
                                  @oninput="args => OnVariableValueChanged(row, args)" spellcheck="false" placeholder='{"approved":true}'></textarea>
                        @if (row.ValueError is not null) { <div class="invalid-feedback">@row.ValueError</div> }
                        else if (row.Kind is not null) { <div class="valid-feedback d-block">Parsed as @row.Kind.</div> }
                    </div>
                    <button class="btn btn-sm btn-outline-danger variable-remove-button" @onclick="() => RemoveVariableRow(row)" disabled="@(variableRows.Count == 1)" aria-label="Remove variable row">Remove</button>
                </div>
            }
        </div>
        <div class="form-text mt-2">@variableRows.Count / @InstanceVariableUpdateInputParser.MaxVariableCount variables. Names are trimmed and compared case-insensitively.</div>

        <label class="form-label mt-3" for="variable-update-reason">Reason</label>
        <textarea id="variable-update-reason" class="form-control" rows="3" value="@reason" @oninput="OnReasonChanged"
                  placeholder="Explain why these administrative values are required (optional)."></textarea>
        <div class="form-text">Optional, up to 1,000 Unicode characters. @ReasonLength / 1,000</div>
        <div class="d-flex flex-wrap align-items-center gap-3 mt-3">
            <button class="btn btn-primary" @onclick="CreateBatchAsync" disabled="@(!CanCreateBatch)">@(batchOperation ? "Submitting..." : "Freeze and prepare asynchronously")</button>
            <span class="text-muted small">Review prepared counts and warnings before confirming execution.</span>
        </div>
    </section>

    @if (currentBatch is not null)
    {
        var summary = currentBatch.Summary;
        <section class="panel panel-flush mb-3" aria-labelledby="variable-update-current-heading">
            <div class="section-heading px-3 pt-3">
                <div><span class="page-eyebrow">Batch #@summary.Id</span><h2 id="variable-update-current-heading">Preparation and execution</h2><p>@summary.TotalItemCount.ToString("N0") frozen instance(s)</p></div>
                <div class="d-flex flex-wrap gap-2 align-items-center"><StatusBadge Status="@summary.Status" /><button class="btn btn-sm btn-outline-secondary" @onclick="RefreshCurrentBatchAsync" disabled="@refreshingBatch"><AppIcon Name="refresh" /> Refresh</button></div>
            </div>
            <div class="summary-grid px-3 pb-3">
                <div class="summary-item"><span>Instances</span><strong>@summary.TotalItemCount.ToString("N0")</strong></div>
                <div class="summary-item"><span>Eligible</span><strong>@summary.EligibleItemCount.ToString("N0")</strong></div>
                <div class="summary-item"><span>Ineligible</span><strong>@summary.IneligibleItemCount.ToString("N0")</strong></div>
                <div class="summary-item"><span>With warnings</span><strong>@summary.WarningItemCount.ToString("N0")</strong></div>
                <div class="summary-item"><span>Queued</span><strong>@summary.QueuedItemCount.ToString("N0")</strong></div>
                <div class="summary-item"><span>Succeeded</span><strong>@summary.SucceededItemCount.ToString("N0")</strong></div>
                <div class="summary-item"><span>Skipped</span><strong>@summary.SkippedItemCount.ToString("N0")</strong></div>
                <div class="summary-item"><span>Failed</span><strong>@summary.FailedItemCount.ToString("N0")</strong></div>
                <div class="summary-item"><span>Cancelled</span><strong>@summary.CancelledItemCount.ToString("N0")</strong></div>
            </div>
            <div class="border-top px-3 py-3">
                <h3 class="h6">Frozen request</h3>
                <dl class="row mb-3">
                    <dt class="col-md-2">Workflow family</dt><dd class="col-md-10">@summary.WorkflowKey (@summary.WorkflowDefinitionCount workflow version(s))</dd>
                    <dt class="col-md-2">Reason</dt><dd class="col-md-10 text-break">@(summary.Reason ?? "No reason supplied")</dd>
                    <dt class="col-md-2">Prepared by</dt><dd class="col-md-10">@summary.PreparedBy (@RoleSnapshot(currentBatch.PreparedByRoles))</dd>
                    <dt class="col-md-2">Confirmed by</dt><dd class="col-md-10">@(summary.ConfirmedBy is null ? "Not confirmed" : $"{summary.ConfirmedBy} ({RoleSnapshot(currentBatch.ConfirmedByRoles)})")</dd>
                </dl>
                <div class="frozen-variable-grid mb-3">
                    @foreach (var variable in currentBatch.Variables)
                    {
                        <div class="frozen-variable"><strong>@variable.Name</strong><pre class="variable-update-json">@FormatJson(variable.Value)</pre></div>
                    }
                </div>
                @if (currentBatch.Issues.Count > 0)
                {
                    <div class="alert alert-warning py-2">
                        <strong>Batch warnings</strong>
                        <ul class="variable-issue-list mb-0">@foreach (var issue in currentBatch.Issues) { <li><strong>@issue.Code:</strong> @issue.Message</li> }</ul>
                    </div>
                }
                @if (currentBatch.Jobs.Count > 0)
                {
                    <details class="mb-2"><summary class="section-link">Durable prepare / execute jobs (@currentBatch.Jobs.Count)</summary>
                        <ul class="variable-issue-list mt-2">@foreach (var job in currentBatch.Jobs) { <li><strong>@job.Phase:</strong> @job.Workflow.Name v@(job.Workflow.Version) - job #@(job.JobId ?? job.OriginalJobId) - @(job.JobStatus ?? "pending")</li> }</ul>
                    </details>
                }
                <details><summary class="section-link">Selection snapshot</summary><pre class="variable-update-json mt-2">@FormatJson(currentBatch.Selection)</pre></details>
            </div>
            <div class="d-flex flex-wrap gap-2 px-3 pb-3">
                @if (CanConfirmCurrentBatch)
                {
                    <button class="btn btn-primary" @onclick="ConfirmCurrentBatchAsync" disabled="@batchOperation">Confirm @summary.EligibleItemCount.ToString("N0") eligible instance(s)</button>
                }
                @if (CanCancelCurrentBatch)
                {
                    <input class="form-control variable-cancellation-input" maxlength="1000" @bind="cancellationReason" placeholder="Cancellation reason (optional)" aria-label="Cancellation reason" />
                    <button class="btn btn-outline-danger" @onclick="CancelCurrentBatchAsync" disabled="@batchOperation">Cancel unstarted instances</button>
                }
            </div>

            <div class="border-top px-3 pt-3">
                <div class="section-heading">
                    <div><h3 class="h6 mb-0">Paged instance results</h3><p>@(batchItems is null ? "Loading items..." : $"{batchItems.TotalCount:N0} matching items")</p></div>
                    <select class="form-select variable-status-filter" value="@batchItemStatus" @onchange="OnBatchItemStatusChangedAsync" aria-label="Filter batch items by status">
                        @foreach (var option in BatchItemStatusOptions) { <option value="@option.Value">@option.Label</option> }
                    </select>
                </div>
            </div>
            @if (batchItems is null)
            {
                <div class="p-3"><div class="skeleton"></div></div>
            }
            else if (batchItems.Items.Count == 0)
            {
                <div class="px-3 pb-3"><EmptyState Icon="instances" Title="No items in this view" Description="Preparation may still be running, or no item has the selected status." /></div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table align-middle">
                        <thead><tr><th>Item</th><th>Instance</th><th>Result and warnings</th><th>Status</th><th>Updated</th></tr></thead>
                        <tbody>
                            @foreach (var item in batchItems.Items)
                            {
                                <tr>
                                    <td>#@item.Id</td>
                                    <td><a class="data-title" href="@($"instances/{item.InstanceId}")">Instance #@item.InstanceId</a><span class="data-subtitle">@(item.BusinessKey ?? "No business key")</span></td>
                                    <td class="variable-result-cell">@BatchItemResult(item)</td>
                                    <td><StatusBadge Status="@item.Status" /></td>
                                    <td>@item.UpdatedAt.ToLocalTime().ToString("g")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="pagination-bar">
                    <span class="pagination-copy">Page @batchItemPage of @BatchItemTotalPages</span>
                    <div class="d-flex gap-2">
                        <button class="btn btn-sm btn-outline-secondary" disabled="@(batchItemPage <= 1 || refreshingBatch)" @onclick="PreviousBatchItemPageAsync">Previous</button>
                        <button class="btn btn-sm btn-outline-secondary" disabled="@(batchItemPage >= BatchItemTotalPages || refreshingBatch)" @onclick="NextBatchItemPageAsync">Next</button>
                    </div>
                </div>
            }
        </section>
    }

    <section class="panel panel-flush" aria-labelledby="variable-update-batches-heading">
        <div class="section-heading px-3 pt-3">
            <div><h2 id="variable-update-batches-heading">Recent batches</h2><p>Prepared and executed variable updates are retained and can be reopened.</p></div>
            <select class="form-select variable-status-filter" value="@batchListStatus" @onchange="OnBatchListStatusChangedAsync" aria-label="Filter batches by status">
                @foreach (var option in BatchStatusOptions) { <option value="@option.Value">@option.Label</option> }
            </select>
        </div>
        @if (batchList is null)
        {
            <div class="p-3"><div class="skeleton" role="status"></div></div>
        }
        else if (batchList.Items.Count == 0)
        {
            <div class="px-3 pb-3"><EmptyState Icon="instances" Title="No variable-update batches" Description="No batch matches the selected status." /></div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table align-middle">
                    <thead><tr><th>Batch</th><th>Workflow</th><th>Requested by</th><th>Progress</th><th>Status</th><th>Updated</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var item in batchList.Items)
                        {
                            <tr class="@(currentBatch?.Summary.Id == item.Id ? "table-active" : null)">
                                <td>#@item.Id</td>
                                <td>@item.WorkflowKey<span class="data-subtitle">@item.WorkflowDefinitionCount version(s) - @item.VariableCount variable(s)</span></td>
                                <td>@item.PreparedBy</td>
                                <td>@item.SucceededItemCount.ToString("N0") / @item.TotalItemCount.ToString("N0")<span class="data-subtitle">@item.EligibleItemCount.ToString("N0") eligible - @item.WarningItemCount.ToString("N0") warning - @item.FailedItemCount.ToString("N0") failed</span></td>
                                <td><StatusBadge Status="@item.Status" /></td>
                                <td>@item.UpdatedAt.ToLocalTime().ToString("g")</td>
                                <td class="text-end"><button class="btn btn-sm btn-outline-primary" @onclick="() => OpenBatchAsync(item.Id)">Open</button></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="pagination-bar">
                <span class="pagination-copy">Page @batchListPage of @BatchListTotalPages - @batchList.TotalCount.ToString("N0") batches</span>
                <div class="d-flex gap-2">
                    <button class="btn btn-sm btn-outline-secondary" disabled="@(batchListPage <= 1 || loadingBatches)" @onclick="PreviousBatchListPageAsync">Previous</button>
                    <button class="btn btn-sm btn-outline-secondary" disabled="@(batchListPage >= BatchListTotalPages || loadingBatches)" @onclick="NextBatchListPageAsync">Next</button>
                </div>
            </div>
        }
    </section>
}

@code {
    [SupplyParameterFromQuery(Name = "batchId")]
    public long? RequestedBatchId { get; set; }

    private const int CandidatePageSize = 50;
    private const int BatchListPageSize = 25;
    private const int BatchItemPageSize = 50;
    private const int MaxBatchInstances = 10_000;
    private const int MaxExpandedWrites = 100_000;
    private static readonly JsonSerializerOptions JsonOptions = new(JsonSerializerDefaults.Web) { WriteIndented = true };
    private static readonly IReadOnlyList<SortFieldOption> CandidateSortOptions =
    [
        new("id", "Instance ID"),
        new("createdAt", "Created"),
        new("updatedAt", "Updated")
    ];
    private static readonly (string Value, string Label)[] BatchStatusOptions =
    [
        ("", "All statuses"), ("preparing", "Preparing"), ("ready", "Ready"), ("queued", "Queued"),
        ("running", "Running"), ("completed", "Completed"), ("completedWithIssues", "Completed with issues"),
        ("cancelled", "Cancelled"), ("failed", "Failed")
    ];
    private static readonly (string Value, string Label)[] BatchItemStatusOptions =
    [
        ("", "All item statuses"), ("preparing", "Preparing"), ("eligible", "Eligible"),
        ("ineligible", "Ineligible"), ("queued", "Queued"), ("succeeded", "Succeeded"),
        ("skipped", "Skipped"), ("failed", "Failed"), ("cancelled", "Cancelled")
    ];

    private IReadOnlyList<WorkflowSummaryDto>? workflowFamilies;
    private IReadOnlyList<WorkflowSummaryDto> workflowVersions = [];
    private string? selectedWorkflowKey;
    private long? selectedWorkflowDefinitionId;
    private long? candidateInstanceId;
    private string? candidateBusinessKey;
    private int? candidateNodeId;
    private string? candidateNodeExternalId;
    private string? candidateVariableFilterJson;
    private string? candidateVariableFilterError;
    private bool includeVariables;
    private bool appliedIncludeVariables;
    private IReadOnlyList<SearchSortDto> candidateSort = [new("updatedAt", "desc")];
    private IReadOnlyList<SearchSortDto> appliedCandidateSort = [new("updatedAt", "desc")];
    private PagedResult<InstanceVariableUpdateCandidateDto>? candidates;
    private InstanceVariableUpdateCandidateFilterDto? appliedCandidateFilter;
    private readonly List<string?> candidatePageCursors = [null];
    private readonly HashSet<long> explicitlySelectedInstances = [];
    private readonly HashSet<long> excludedInstances = [];
    private bool allMatchingSelection;
    private int candidatePage = 1;
    private bool candidateFiltersDirty;
    private long candidateRequestVersion;
    private long definitionRequestVersion;
    private readonly List<VariableDraft> variableRows = [new(1)];
    private int nextVariableRowId = 2;
    private string reason = string.Empty;
    private string? draftIdempotencyKey;
    private InstanceVariableUpdateBatchDetailDto? currentBatch;
    private PagedResult<InstanceVariableUpdateBatchItemDto>? batchItems;
    private string? batchItemStatus;
    private int batchItemPage = 1;
    private PagedResult<InstanceVariableUpdateBatchSummaryDto>? batchList;
    private string? batchListStatus;
    private int batchListPage = 1;
    private string? cancellationReason;
    private string? error;
    private string? success;
    private bool loading;
    private bool loadingDefinition;
    private bool candidateLoading;
    private bool batchOperation;
    private bool refreshingBatch;
    private bool loadingBatches;
    private long batchDetailRequestVersion;
    private long batchItemRequestVersion;
    private long batchListRequestVersion;
    private readonly CancellationTokenSource pollCancellation = new();
    private Task? pollTask;

    private string SelectedWorkflowDefinitionIdText => selectedWorkflowDefinitionId?.ToString() ?? string.Empty;
    private bool CanSearchCandidates => !candidateLoading && !loadingDefinition && !string.IsNullOrWhiteSpace(selectedWorkflowKey);
    private long SelectedCandidateCount => allMatchingSelection
        ? Math.Max(0, (candidates?.TotalCount ?? 0) - excludedInstances.Count)
        : explicitlySelectedInstances.Count;
    private long ExpandedWriteCount => SelectedCandidateCount > long.MaxValue / Math.Max(1, variableRows.Count)
        ? long.MaxValue
        : SelectedCandidateCount * variableRows.Count;
    private int ReasonLength => reason.Trim().EnumerateRunes().Count();
    private bool HasValidReason => ReasonLength <= 1000;
    private bool HasValidVariables => variableRows.Count is > 0 and <= InstanceVariableUpdateInputParser.MaxVariableCount
        && variableRows.All(row => row.NameError is null && row.ValueError is null && row.ParsedValue is not null);
    private bool CanCreateBatch => !batchOperation && !candidateFiltersDirty && appliedCandidateFilter is not null
        && SelectedCandidateCount is > 0 and <= MaxBatchInstances && ExpandedWriteCount <= MaxExpandedWrites
        && HasValidReason && HasValidVariables;
    private int BatchItemTotalPages => TotalPages(batchItems?.TotalCount ?? 0, BatchItemPageSize);
    private int BatchListTotalPages => TotalPages(batchList?.TotalCount ?? 0, BatchListPageSize);
    private bool CanConfirmCurrentBatch => currentBatch?.Summary.Status.Equals("ready", StringComparison.OrdinalIgnoreCase) == true
        && currentBatch.Summary.EligibleItemCount > 0;
    private bool CanCancelCurrentBatch => currentBatch is not null && IsCancellable(currentBatch.Summary.Status);
    private string CandidateSummary => candidateFiltersDirty
        ? "Filters or sort changed. Search again to establish a new server-side result."
        : candidateLoading ? "Searching running instances..."
        : candidates is null ? "No search has run yet."
        : $"{candidates.TotalCount:N0} running instance(s)";

    protected override async Task OnInitializedAsync()
    {
        Token.Changed += OnTokenChanged;
        ValidateVariableRows();
        pollTask = PollCurrentBatchAsync(pollCancellation.Token);
        if (Token.HasToken) await LoadInitialAsync();
    }

    private async Task LoadInitialAsync()
    {
        try
        {
            loading = true;
            error = null;
            workflowFamilies = (await Api.GetWorkflowsAsync())
                .GroupBy(workflow => workflow.WorkflowKey, StringComparer.OrdinalIgnoreCase)
                .Select(group => group.OrderByDescending(workflow => workflow.Version).ThenByDescending(workflow => workflow.Id).First())
                .OrderBy(workflow => workflow.Name, StringComparer.OrdinalIgnoreCase)
                .ThenBy(workflow => workflow.WorkflowKey, StringComparer.OrdinalIgnoreCase)
                .ToArray();
            if (string.IsNullOrWhiteSpace(selectedWorkflowKey)
                || workflowFamilies.All(workflow => !workflow.WorkflowKey.Equals(selectedWorkflowKey, StringComparison.OrdinalIgnoreCase)))
            {
                selectedWorkflowKey = workflowFamilies.FirstOrDefault()?.WorkflowKey;
                selectedWorkflowDefinitionId = null;
            }
            if (!string.IsNullOrWhiteSpace(selectedWorkflowKey)) await LoadWorkflowFamilyAsync(selectedWorkflowKey);
            await LoadBatchListAsync();
            if (RequestedBatchId is > 0) await OpenBatchAsync(RequestedBatchId.Value);
        }
        catch (Exception ex)
        {
            error = ex.Message;
            workflowFamilies ??= [];
        }
        finally { loading = false; }
    }

    private async Task RefreshAllAsync()
    {
        if (!Token.HasToken) return;
        var openedBatchId = currentBatch?.Summary.Id;
        await LoadInitialAsync();
        if (openedBatchId is long batchId) await OpenBatchAsync(batchId);
    }

    private async Task OnWorkflowFamilyChangedAsync(ChangeEventArgs args)
    {
        selectedWorkflowKey = args.Value?.ToString();
        selectedWorkflowDefinitionId = null;
        draftIdempotencyKey = null;
        ResetCandidateResults();
        if (!string.IsNullOrWhiteSpace(selectedWorkflowKey)) await LoadWorkflowFamilyAsync(selectedWorkflowKey);
    }

    private async Task LoadWorkflowFamilyAsync(string workflowKey)
    {
        var request = ++definitionRequestVersion;
        try
        {
            loadingDefinition = true;
            error = null;
            var versions = (await Api.GetWorkflowVersionsAsync(workflowKey))
                .OrderByDescending(version => version.Version).ThenByDescending(version => version.Id).ToArray();
            if (request != definitionRequestVersion) return;
            workflowVersions = versions;
            if (selectedWorkflowDefinitionId is long selected && versions.All(version => version.Id != selected)) selectedWorkflowDefinitionId = null;
        }
        catch (Exception ex)
        {
            if (request != definitionRequestVersion) return;
            error = ex.Message;
            workflowVersions = [];
            selectedWorkflowDefinitionId = null;
        }
        finally
        {
            if (request == definitionRequestVersion)
            {
                loadingDefinition = false;
                ResetCandidateResults();
            }
        }
    }

    private void OnWorkflowVersionChanged(ChangeEventArgs args)
    {
        selectedWorkflowDefinitionId = long.TryParse(args.Value?.ToString(), out var id) && id > 0 ? id : null;
        draftIdempotencyKey = null;
        ResetCandidateResults();
    }

    private void InvalidateCandidateSearch()
    {
        candidateRequestVersion++;
        candidateLoading = false;
        if (candidates is not null) candidateFiltersDirty = true;
        ResetCandidatePaging();
        ClearSelection();
    }

    private void OnCandidateInstanceIdInput(ChangeEventArgs args) { candidateInstanceId = long.TryParse(args.Value?.ToString(), out var value) ? value : null; InvalidateCandidateSearch(); }
    private void OnCandidateBusinessKeyInput(ChangeEventArgs args) { candidateBusinessKey = args.Value?.ToString(); InvalidateCandidateSearch(); }
    private void OnCandidateNodeIdInput(ChangeEventArgs args) { candidateNodeId = int.TryParse(args.Value?.ToString(), out var value) ? value : null; InvalidateCandidateSearch(); }
    private void OnCandidateNodeExternalIdInput(ChangeEventArgs args) { candidateNodeExternalId = args.Value?.ToString(); InvalidateCandidateSearch(); }
    private Task OnCandidateVariableFilterChanged(string? value) { candidateVariableFilterJson = value; candidateVariableFilterError = null; InvalidateCandidateSearch(); return Task.CompletedTask; }
    private void OnIncludeVariablesChanged(ChangeEventArgs args) { includeVariables = args.Value is true; InvalidateCandidateSearch(); }

    private async Task ApplyCandidateSortAsync(IReadOnlyList<SearchSortDto> value)
    {
        candidateSort = value;
        InvalidateCandidateSearch();
        if (!string.IsNullOrWhiteSpace(selectedWorkflowKey)) await SearchCandidatesAsync();
    }

    private async Task ClearCandidateFiltersAsync()
    {
        candidateInstanceId = null;
        candidateBusinessKey = null;
        candidateNodeId = null;
        candidateNodeExternalId = null;
        candidateVariableFilterJson = null;
        candidateVariableFilterError = null;
        includeVariables = false;
        InvalidateCandidateSearch();
        await SearchCandidatesAsync();
    }

    private async Task SearchCandidatesAsync()
    {
        if (!CanSearchCandidates || string.IsNullOrWhiteSpace(selectedWorkflowKey)) return;
        if (!AdvancedVariableFilterInput.TryParse(candidateVariableFilterJson, out JsonElement? variableFilter, out candidateVariableFilterError)) return;
        var request = ++candidateRequestVersion;
        try
        {
            candidateLoading = true;
            error = null;
            success = null;
            var filter = new InstanceVariableUpdateCandidateFilterDto
            {
                WorkflowKey = selectedWorkflowKey,
                WorkflowId = selectedWorkflowDefinitionId,
                InstanceId = candidateInstanceId,
                BusinessKey = string.IsNullOrWhiteSpace(candidateBusinessKey) ? null : candidateBusinessKey.Trim(),
                NodeId = candidateNodeId,
                NodeExternalId = string.IsNullOrWhiteSpace(candidateNodeExternalId) ? null : candidateNodeExternalId.Trim(),
                VariableFilter = variableFilter
            };
            var loaded = await Api.SearchInstanceVariableUpdateCandidatesAsync(new InstanceVariableUpdateCandidateSearchRequest
            {
                Filter = filter,
                IncludeVariables = includeVariables,
                Sort = candidateSort,
                Cursor = null,
                Page = 1,
                PageSize = CandidatePageSize
            });
            if (request != candidateRequestVersion) return;
            appliedCandidateFilter = filter;
            appliedCandidateSort = candidateSort.ToArray();
            appliedIncludeVariables = includeVariables;
            ResetCandidatePaging();
            candidates = loaded;
            candidateFiltersDirty = false;
            ClearSelection();
        }
        catch (Exception ex)
        {
            if (request != candidateRequestVersion) return;
            error = ex.Message;
            candidates = null;
            appliedCandidateFilter = null;
        }
        finally { if (request == candidateRequestVersion) candidateLoading = false; }
    }

    private async Task<bool> LoadCandidatePageAsync(int page, string? cursor)
    {
        if (appliedCandidateFilter is null) return false;
        var request = ++candidateRequestVersion;
        try
        {
            candidateLoading = true;
            var loaded = await Api.SearchInstanceVariableUpdateCandidatesAsync(new InstanceVariableUpdateCandidateSearchRequest
            {
                Filter = appliedCandidateFilter,
                IncludeVariables = appliedIncludeVariables,
                Sort = appliedCandidateSort,
                Cursor = cursor,
                Page = page,
                PageSize = CandidatePageSize
            });
            if (request != candidateRequestVersion) return false;
            candidatePage = page;
            candidates = loaded;
            return true;
        }
        catch (Exception ex) { if (request == candidateRequestVersion) error = ex.Message; }
        finally { if (request == candidateRequestVersion) candidateLoading = false; }
        return false;
    }

    private async Task PreviousCandidatePageAsync()
    {
        if (candidatePage <= 1) return;
        var targetPage = candidatePage - 1;
        var targetCursor = candidatePageCursors[targetPage - 1];
        if (await LoadCandidatePageAsync(targetPage, targetCursor))
        {
            while (candidatePageCursors.Count > targetPage) candidatePageCursors.RemoveAt(candidatePageCursors.Count - 1);
        }
    }

    private async Task NextCandidatePageAsync()
    {
        if (string.IsNullOrWhiteSpace(candidates?.NextCursor)) return;
        var targetPage = candidatePage + 1;
        var targetCursor = candidates.NextCursor;
        if (await LoadCandidatePageAsync(targetPage, targetCursor))
        {
            if (candidatePageCursors.Count < targetPage) candidatePageCursors.Add(targetCursor);
            else candidatePageCursors[targetPage - 1] = targetCursor;
        }
    }

    private bool IsCandidateSelected(long instanceId) => allMatchingSelection ? !excludedInstances.Contains(instanceId) : explicitlySelectedInstances.Contains(instanceId);
    private void ToggleCandidate(long instanceId) { if (allMatchingSelection) { if (!excludedInstances.Add(instanceId)) excludedInstances.Remove(instanceId); } else if (!explicitlySelectedInstances.Add(instanceId)) explicitlySelectedInstances.Remove(instanceId); draftIdempotencyKey = null; }
    private void SelectCurrentCandidatePage() { if (candidates is null) return; if (allMatchingSelection) foreach (var candidate in candidates.Items) excludedInstances.Remove(candidate.InstanceId); else foreach (var candidate in candidates.Items) explicitlySelectedInstances.Add(candidate.InstanceId); draftIdempotencyKey = null; }
    private void SetSelectionMode(bool allMatching) { allMatchingSelection = allMatching; explicitlySelectedInstances.Clear(); excludedInstances.Clear(); draftIdempotencyKey = null; }
    private void ClearSelection() { explicitlySelectedInstances.Clear(); excludedInstances.Clear(); draftIdempotencyKey = null; }

    private void AddVariableRow() { if (variableRows.Count >= InstanceVariableUpdateInputParser.MaxVariableCount) return; variableRows.Add(new VariableDraft(nextVariableRowId++)); ValidateVariableRows(); draftIdempotencyKey = null; }
    private void RemoveVariableRow(VariableDraft row) { if (variableRows.Count == 1) return; variableRows.Remove(row); ValidateVariableRows(); draftIdempotencyKey = null; }
    private void OnVariableNameChanged(VariableDraft row, ChangeEventArgs args) { row.Name = args.Value?.ToString() ?? string.Empty; ValidateVariableRows(); draftIdempotencyKey = null; }
    private void OnVariableValueChanged(VariableDraft row, ChangeEventArgs args) { row.RawValue = args.Value?.ToString() ?? string.Empty; ValidateVariableRows(); draftIdempotencyKey = null; }
    private void OnReasonChanged(ChangeEventArgs args) { reason = args.Value?.ToString() ?? string.Empty; draftIdempotencyKey = null; }

    private void ValidateVariableRows()
    {
        var duplicateErrors = InstanceVariableUpdateInputParser.FindDuplicateNameErrors(variableRows.Select(row => (string?)row.Name).ToArray());
        for (var index = 0; index < variableRows.Count; index++)
        {
            var row = variableRows[index];
            row.NameError = duplicateErrors.TryGetValue(index, out var duplicate) ? duplicate : InstanceVariableUpdateInputParser.ValidateName(row.Name);
            if (InstanceVariableUpdateInputParser.TryParseValue(row.RawValue, out var value, out var kind, out var valueError))
            {
                row.ParsedValue = value;
                row.Kind = kind;
                row.ValueError = null;
            }
            else
            {
                row.ParsedValue = null;
                row.Kind = null;
                row.ValueError = valueError;
            }
        }
    }

    private async Task CreateBatchAsync()
    {
        ValidateVariableRows();
        if (!CanCreateBatch || appliedCandidateFilter is null || string.IsNullOrWhiteSpace(selectedWorkflowKey)) return;
        try
        {
            batchOperation = true;
            error = null;
            success = null;
            draftIdempotencyKey ??= Guid.NewGuid().ToString("N");
            var selection = allMatchingSelection
                ? new InstanceVariableUpdateBatchSelectionDto(InstanceVariableUpdateBatchSelectionModes.AllMatching, null, appliedCandidateFilter, excludedInstances.Order().ToArray())
                : new InstanceVariableUpdateBatchSelectionDto(InstanceVariableUpdateBatchSelectionModes.Explicit, explicitlySelectedInstances.Order().ToArray(), null, null);
            var writes = variableRows.Select(row => new InstanceVariableWriteDto(row.Name.Trim(), row.ParsedValue!.Value)).ToArray();
            currentBatch = await Api.CreateInstanceVariableUpdateBatchAsync(new CreateInstanceVariableUpdateBatchRequest(
                selectedWorkflowKey, writes, string.IsNullOrWhiteSpace(reason) ? null : reason.Trim(), selection, draftIdempotencyKey));
            batchDetailRequestVersion++;
            batchItemRequestVersion++;
            draftIdempotencyKey = null;
            batchItemPage = 1;
            batchItemStatus = null;
            await LoadBatchItemsAsync();
            await LoadBatchListAsync();
            success = $"Batch #{currentBatch.Summary.Id} was frozen and queued for asynchronous preparation.";
        }
        catch (Exception ex) { error = ex.Message; }
        finally { batchOperation = false; }
    }

    private async Task OpenBatchAsync(long batchId)
    {
        var request = ++batchDetailRequestVersion;
        refreshingBatch = false;
        try
        {
            error = null;
            var loaded = await Api.GetInstanceVariableUpdateBatchAsync(batchId) ?? throw new InvalidOperationException($"Instance-variable update batch #{batchId} was not found.");
            if (request != batchDetailRequestVersion) return;
            currentBatch = loaded;
            batchItemPage = 1;
            batchItemStatus = null;
            cancellationReason = null;
            batchItemRequestVersion++;
            await LoadBatchItemsAsync();
        }
        catch (Exception ex) { if (request == batchDetailRequestVersion) error = ex.Message; }
    }

    private async Task RefreshCurrentBatchAsync()
    {
        if (currentBatch is null || refreshingBatch) return;
        var batchId = currentBatch.Summary.Id;
        var request = ++batchDetailRequestVersion;
        try
        {
            refreshingBatch = true;
            var refreshed = await Api.GetInstanceVariableUpdateBatchAsync(batchId);
            if (request != batchDetailRequestVersion || currentBatch?.Summary.Id != batchId) return;
            if (refreshed is not null) currentBatch = refreshed;
            await LoadBatchItemsAsync();
            await LoadBatchListAsync();
        }
        catch (Exception ex) { if (request == batchDetailRequestVersion) error = ex.Message; }
        finally { if (request == batchDetailRequestVersion) refreshingBatch = false; }
    }

    private async Task ConfirmCurrentBatchAsync()
    {
        if (!CanConfirmCurrentBatch || currentBatch is null) return;
        try
        {
            batchOperation = true;
            error = null;
            var expected = currentBatch.Summary;
            var request = ++batchDetailRequestVersion;
            var confirmed = await Api.ConfirmInstanceVariableUpdateBatchAsync(expected.Id, new ConfirmInstanceVariableUpdateBatchRequest(expected.EligibleItemCount, expected.IneligibleItemCount, expected.WarningItemCount, expected.UpdatedAt));
            if (request != batchDetailRequestVersion || currentBatch?.Summary.Id != expected.Id) return;
            currentBatch = confirmed;
            success = $"Batch #{expected.Id} was confirmed. Eligible instances are queued for independent variable updates.";
            await LoadBatchItemsAsync();
            await LoadBatchListAsync();
        }
        catch (Exception ex) { error = ex.Message; }
        finally { batchOperation = false; }
    }

    private async Task CancelCurrentBatchAsync()
    {
        if (!CanCancelCurrentBatch || currentBatch is null) return;
        try
        {
            batchOperation = true;
            error = null;
            var id = currentBatch.Summary.Id;
            var request = ++batchDetailRequestVersion;
            var cancelled = await Api.CancelInstanceVariableUpdateBatchAsync(id, new CancelInstanceVariableUpdateBatchRequest(string.IsNullOrWhiteSpace(cancellationReason) ? null : cancellationReason.Trim()));
            if (request != batchDetailRequestVersion || currentBatch?.Summary.Id != id) return;
            currentBatch = cancelled;
            success = $"Batch #{id} was cancelled. Successful variable updates were not reversed.";
            await LoadBatchItemsAsync();
            await LoadBatchListAsync();
        }
        catch (Exception ex) { error = ex.Message; }
        finally { batchOperation = false; }
    }

    private async Task LoadBatchItemsAsync()
    {
        if (currentBatch is null) return;
        var batchId = currentBatch.Summary.Id;
        var status = batchItemStatus;
        var page = batchItemPage;
        var request = ++batchItemRequestVersion;
        var loaded = await Api.GetInstanceVariableUpdateBatchItemsAsync(batchId, status, page, BatchItemPageSize);
        if (request == batchItemRequestVersion && currentBatch?.Summary.Id == batchId && batchItemStatus == status && batchItemPage == page) batchItems = loaded;
    }
    private async Task OnBatchItemStatusChangedAsync(ChangeEventArgs args) { batchItemStatus = args.Value?.ToString(); batchItemPage = 1; await LoadBatchItemsAsync(); }
    private async Task PreviousBatchItemPageAsync() { batchItemPage = Math.Max(1, batchItemPage - 1); await LoadBatchItemsAsync(); }
    private async Task NextBatchItemPageAsync() { batchItemPage = Math.Min(BatchItemTotalPages, batchItemPage + 1); await LoadBatchItemsAsync(); }

    private async Task LoadBatchListAsync()
    {
        var request = ++batchListRequestVersion;
        var status = batchListStatus;
        var page = batchListPage;
        try
        {
            loadingBatches = true;
            var loaded = await Api.GetInstanceVariableUpdateBatchesAsync(new InstanceVariableUpdateBatchSearchRequest { Status = string.IsNullOrWhiteSpace(status) ? null : status, Page = page, PageSize = BatchListPageSize });
            if (request == batchListRequestVersion && batchListStatus == status && batchListPage == page) batchList = loaded;
        }
        finally { if (request == batchListRequestVersion) loadingBatches = false; }
    }
    private async Task OnBatchListStatusChangedAsync(ChangeEventArgs args) { batchListStatus = args.Value?.ToString(); batchListPage = 1; await LoadBatchListAsync(); }
    private async Task PreviousBatchListPageAsync() { batchListPage = Math.Max(1, batchListPage - 1); await LoadBatchListAsync(); }
    private async Task NextBatchListPageAsync() { batchListPage = Math.Min(BatchListTotalPages, batchListPage + 1); await LoadBatchListAsync(); }

    private async Task PollCurrentBatchAsync(CancellationToken cancellationToken)
    {
        try
        {
            using var timer = new PeriodicTimer(TimeSpan.FromSeconds(3));
            while (await timer.WaitForNextTickAsync(cancellationToken))
            {
                if (currentBatch is null || !IsLive(currentBatch.Summary) || refreshingBatch) continue;
                await InvokeAsync(RefreshCurrentBatchAsync);
            }
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested) { }
    }

    private void OnTokenChanged() => _ = InvokeAsync(async () =>
    {
        if (Token.HasToken) await LoadInitialAsync();
        else { workflowFamilies = null; currentBatch = null; batchList = null; }
        StateHasChanged();
    });

    private void ResetCandidateResults() { candidateRequestVersion++; candidates = null; appliedCandidateFilter = null; candidateFiltersDirty = false; appliedIncludeVariables = false; ResetCandidatePaging(); ClearSelection(); }
    private void ResetCandidatePaging() { candidatePage = 1; candidatePageCursors.Clear(); candidatePageCursors.Add(null); }

    private RenderFragment BatchItemResult(InstanceVariableUpdateBatchItemDto item) => @<div>
        @if (!string.IsNullOrWhiteSpace(item.ErrorDescription))
        {
            <span class="text-danger">@item.ErrorDescription</span>
        }
        @if (item.Plan.Count > 0)
        {
            <div class="variable-outcome-list" aria-label="Prepared variable outcomes">
                @foreach (var outcome in item.Plan)
                {
                    <span><code>@outcome.Name</code> <StatusBadge Status="@outcome.Outcome" /></span>
                }
            </div>
        }
        @if (item.Warnings.Count > 0)
        {
            <details><summary class="section-link">@item.Warnings.Count warning(s)</summary><ul class="variable-issue-list">@foreach (var issue in item.Warnings) { <li><strong>@issue.Code:</strong> @issue.Message</li> }</ul></details>
        }
        @if (item.UpdateOperationId is long operationId)
        {
            <a class="section-link" href="@($"instances/{item.InstanceId}#variable-updates")">Variable-update audit #@operationId</a>
        }
        @if (item.Result is JsonElement result)
        {
            <details><summary class="section-link">Actual add / update result</summary><pre class="variable-update-json mt-2">@FormatJson(result)</pre></details>
        }
        @if (string.IsNullOrWhiteSpace(item.ErrorDescription) && item.Plan.Count == 0 && item.Warnings.Count == 0 && item.UpdateOperationId is null && item.Result is null)
        {
            <span class="text-muted">-</span>
        }
    </div>;

    private static string RoleSnapshot(IReadOnlyList<string>? roles) => roles is null || roles.Count == 0 ? "no roles" : string.Join(", ", roles);
    private static string FormatJson<T>(T value) => JsonSerializer.Serialize(value, JsonOptions);
    private static int TotalPages(long totalCount, int pageSize) => totalCount == 0 ? 1 : (int)Math.Ceiling(totalCount / (double)pageSize);
    private static bool IsCancellable(string status) => status.Equals("preparing", StringComparison.OrdinalIgnoreCase) || status.Equals("ready", StringComparison.OrdinalIgnoreCase) || status.Equals("queued", StringComparison.OrdinalIgnoreCase) || status.Equals("running", StringComparison.OrdinalIgnoreCase);
    private static bool IsLive(InstanceVariableUpdateBatchSummaryDto summary) => summary.Status.Equals("preparing", StringComparison.OrdinalIgnoreCase) || summary.Status.Equals("queued", StringComparison.OrdinalIgnoreCase) || summary.Status.Equals("running", StringComparison.OrdinalIgnoreCase) || (summary.Status.Equals("cancelled", StringComparison.OrdinalIgnoreCase) && summary.CompletedAt is null);

    public async ValueTask DisposeAsync()
    {
        Token.Changed -= OnTokenChanged;
        await pollCancellation.CancelAsync();
        if (pollTask is not null) { try { await pollTask; } catch (OperationCanceledException) { } }
        pollCancellation.Dispose();
    }

    private sealed class VariableDraft(int id)
    {
        public int Id { get; } = id;
        public string Name { get; set; } = string.Empty;
        public string RawValue { get; set; } = "null";
        public string? NameError { get; set; }
        public string? ValueError { get; set; }
        public string? Kind { get; set; }
        public JsonElement? ParsedValue { get; set; }
    }
}
