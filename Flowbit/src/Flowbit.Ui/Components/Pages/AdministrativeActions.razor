@page "/administrative-actions"
@implements IAsyncDisposable
@using System.Text
@using System.Text.Json
@using Flowbit.Ui.Auth
@inject WorkflowApiClient Api
@inject TokenState Token

<PageTitle>Administrative actions · Flowbit</PageTitle>

<PageHeader Eyebrow="Manage" Title="Administrative actions"
            Description="Freeze running execution positions, review them, and invoke one exact authored action as a durable batch.">
    <Actions>
        <button class="btn btn-outline-secondary" @onclick="RefreshAllAsync" disabled="@loading"><AppIcon Name="refresh" /> Refresh</button>
    </Actions>
</PageHeader>

<div class="alert alert-warning admin-no-rollback-warning" role="note">
    <strong>This is a privileged override, not a rollback.</strong>
    Task and flow roles, assignment, claim ownership, and the selected flow condition are ignored. The action creates new history;
    it does not restore variables, erase earlier visits, or reverse messages, scripts, service calls, or other external effects.
    Automatic paths can invoke external systems again.
</div>

<div class="alert alert-danger" role="note">
    <strong>Timer-boundary actions fire immediately.</strong>
    Their due time is ignored and the host work is always interrupted, including boundaries authored as non-interrupting.
</div>

@if (!string.IsNullOrWhiteSpace(error))
{
    <div class="alert alert-danger" role="alert">@error</div>
}
@if (!string.IsNullOrWhiteSpace(success))
{
    <div class="alert alert-success" role="status">@success</div>
}

@if (!Token.HasToken)
{
    <section class="panel">
        <EmptyState Icon="token" Title="An authenticated identity is required"
                    Description="Set a test identity before searching or executing administrative actions. This feature does not require a workflow role.">
            <a class="btn btn-primary" href="token">Set test identity</a>
        </EmptyState>
    </section>
}
else
{
    <section class="panel mb-3" aria-labelledby="admin-position-heading">
        <div class="section-heading">
            <div>
                <h2 id="admin-position-heading">1. Choose the exact waiting position</h2>
                <p>Select one workflow family, immutable version, and ordinary or multi-instance user-task node. Running instances never change version.</p>
            </div>
        </div>

        @if (workflowFamilies is null)
        {
            <div class="skeleton" role="status"></div>
        }
        else if (workflowFamilies.Count == 0)
        {
            <EmptyState Icon="workflows" Title="No workflow definitions" Description="No workflow version with a user-task node is available." />
        }
        else
        {
            <div class="admin-definition-grid">
                <div>
                    <label class="form-label" for="admin-workflow-family">Workflow family <span class="required-mark">*</span></label>
                    <select id="admin-workflow-family" class="form-select" value="@selectedWorkflowKey"
                            @onchange="OnWorkflowFamilyChangedAsync" disabled="@loadingDefinition">
                        @foreach (var workflow in workflowFamilies)
                        {
                            <option value="@workflow.WorkflowKey">@workflow.Name (@workflow.WorkflowKey)</option>
                        }
                    </select>
                </div>
                <div>
                    <label class="form-label" for="admin-workflow-version">Exact immutable version <span class="required-mark">*</span></label>
                    <select id="admin-workflow-version" class="form-select" value="@SelectedWorkflowDefinitionIdText"
                            @onchange="OnWorkflowVersionChangedAsync" disabled="@(loadingDefinition || workflowVersions.Count == 0)">
                        @foreach (var version in workflowVersions)
                        {
                            <option value="@version.Id">v@(version.Version) · definition #@version.Id@(version.IsDefault ? " · default" : string.Empty)@(version.IsPublished ? " · published" : " · immutable")</option>
                        }
                    </select>
                </div>
                <div>
                    <label class="form-label" for="admin-source-node">Waiting user-task node <span class="required-mark">*</span></label>
                    <select id="admin-source-node" class="form-select" value="@SelectedSourceNodeIdText"
                            @onchange="OnSourceNodeChangedAsync" disabled="@(loadingDefinition || sourceNodes.Count == 0)">
                        @foreach (var node in sourceNodes)
                        {
                            <option value="@node.NodeId">@node.Name · node #@node.NodeId@(node.IsMultiInstance ? " · multi-instance" : string.Empty)</option>
                        }
                    </select>
                </div>
            </div>

            @if (loadingDefinition)
            {
                <div class="skeleton mt-3" role="status"></div>
            }
            else if (SelectedWorkflowVersion is not null && sourceNodes.Count == 0)
            {
                <div class="alert alert-secondary mt-3 mb-0">This exact version has no user-task nodes.</div>
            }
            else if (SelectedWorkflowVersion is { } selectedVersion && SelectedSourceNode is { } selectedNode)
            {
                <div class="alert alert-info mt-3 mb-0">
                    Searching definition <strong>#@selectedVersion.Id, v@selectedVersion.Version</strong> at
                    <strong>@selectedNode.Name (#@selectedNode.NodeId)</strong>.
                    @(selectedNode.IsMultiInstance
                        ? "Each result represents one parent multi-instance execution."
                        : "Each result represents one ordinary user-task position.")
                </div>
            }
        }
    </section>

    <section class="filter-panel mb-3" aria-labelledby="admin-search-heading">
        <div class="section-heading">
            <div>
                <h2 id="admin-search-heading">2. Search running positions</h2>
                <p>Each row is an exact token activation. Parallel sibling branches do not make the matching position ineligible.</p>
            </div>
        </div>
        <div class="filter-grid" @onchange="MarkCandidateFiltersDirty">
            <div><label class="form-label" for="admin-position-id">Position ID</label><input id="admin-position-id" type="number" class="form-control" @bind="candidatePositionId" /></div>
            <div><label class="form-label" for="admin-instance-id">Instance ID</label><input id="admin-instance-id" type="number" class="form-control" @bind="candidateInstanceId" /></div>
            <div><label class="form-label" for="admin-business-key">Business key</label><input id="admin-business-key" class="form-control" @bind="candidateBusinessKey" /></div>
            <div class="filter-span-2">
                <AdvancedVariableFilterEditor Id="admin-variable-filter"
                                              Label="Advanced current-variable filter (JSON)"
                                              Value="@candidateVariableFilterJson"
                                              ValueChanged="OnCandidateVariableFilterChanged"
                                              Error="@candidateVariableFilterError" />
            </div>
            <div class="filter-actions filter-span-2">
                <button class="btn btn-primary" @onclick="SearchCandidatesAsync" disabled="@(!CanSearchCandidates)"><AppIcon Name="search" /> Search positions</button>
                <button class="btn btn-outline-secondary" @onclick="ClearCandidateFiltersAsync" disabled="@candidateLoading">Clear filters</button>
            </div>
        </div>
    </section>

    <section class="panel panel-flush mb-3" aria-labelledby="admin-candidates-heading">
        <div class="section-heading px-3 pt-3">
            <div>
                <h2 id="admin-candidates-heading">3. Select the frozen population</h2>
                <p>@CandidateSummary</p>
            </div>
            @if (candidates is not null && candidates.TotalCount > 0 && !candidateFiltersDirty)
            {
                <div class="d-flex flex-wrap gap-2">
                    <button class="btn btn-sm btn-outline-secondary" @onclick="SelectCurrentCandidatePage">Select this page</button>
                    <button class="btn btn-sm btn-outline-secondary" @onclick="ClearSelection">@(allMatchingSelection ? "Clear exclusions" : "Clear selection")</button>
                </div>
            }
        </div>

        @if (candidateFiltersDirty)
        {
            <EmptyState Icon="search" Title="Search the changed filters" Description="The prior result and selection will not be used for batch creation." />
        }
        else if (candidateLoading)
        {
            <div class="p-3"><div class="skeleton" role="status"></div></div>
        }
        else if (candidates is null)
        {
            <EmptyState Icon="search" Title="Search for positions" Description="Choose an exact workflow version and node, then run a search." />
        }
        else if (candidates.Items.Count == 0)
        {
            <EmptyState Icon="inbox" Title="No running positions" Description="No active ordinary or multi-instance user-task position matches the filters." />
        }
        else
        {
            <div class="px-3 pb-3">
                <div class="selection-mode-grid mb-3">
                    <label class="selection-mode-card">
                        <input type="radio" name="admin-selection-mode" checked="@(!allMatchingSelection)" @onchange="_ => SetSelectionMode(false)" />
                        <span><strong>Explicit positions</strong><small>Freeze only checked position identities across visited pages.</small></span>
                    </label>
                    <label class="selection-mode-card">
                        <input type="radio" name="admin-selection-mode" checked="@allMatchingSelection" @onchange="_ => SetSelectionMode(true)" />
                        <span><strong>All @candidates.TotalCount.ToString("N0") matching</strong><small>Freeze the server-side result except unchecked exclusions.</small></span>
                    </label>
                </div>
                <div class="alert alert-info py-2 mb-0">
                    Selected positions: <strong>@SelectedCandidateCount.ToString("N0")</strong>.
                    @if (allMatchingSelection)
                    {
                        <text>The exact affected-task total is calculated while preparing.</text>
                    }
                    else
                    {
                        <text>Known affected tasks: <strong>@ExplicitAffectedTaskCount.ToString("N0")</strong>.</text>
                    }
                    The server rejects a frozen selection above 10,000 affected tasks.
                </div>
            </div>

            <div class="table-responsive">
                <table class="table align-middle">
                    <thead><tr><th><span class="visually-hidden">Select</span></th><th>Position / instance</th><th>Waiting node</th><th>Affected work</th><th>Timer subscriptions</th><th>Updated</th></tr></thead>
                    <tbody>
                        @foreach (var candidate in candidates.Items)
                        {
                            var key = PositionKey(candidate);
                            <tr>
                                <td><input class="form-check-input" type="checkbox" aria-label="Select @PositionKindLabel(candidate.PositionKind) position @candidate.PositionId" checked="@IsCandidateSelected(key)" @onchange="_ => ToggleCandidate(candidate)" /></td>
                                <td>
                                    <span class="data-title">@PositionKindLabel(candidate.PositionKind) #@candidate.PositionId</span>
                                    <span class="data-subtitle"><a href="@($"instances/{candidate.InstanceId}")">Instance #@candidate.InstanceId</a> · @(candidate.BusinessKey ?? candidate.WorkflowKey)</span>
                                    <span class="data-subtitle">Token #@candidate.TokenId · activation @ShortActivation(candidate.TokenActivationId)</span>
                                </td>
                                <td>@candidate.NodeName<span class="data-subtitle">Node #@candidate.NodeId@(string.IsNullOrWhiteSpace(candidate.NodeExternalId) ? string.Empty : $" · {candidate.NodeExternalId}") · v@candidate.WorkflowVersion</span></td>
                                <td>
                                    <strong>@candidate.AffectedTaskCount.ToString("N0") task(s)</strong>
                                    <span class="data-subtitle">@(candidate.UserTaskId is long taskId ? $"Task #{taskId}" : $"MI execution #{candidate.MultiInstanceExecutionId}")</span>
                                </td>
                                <td>
                                    @if (candidate.TimerBoundaries.Count == 0)
                                    {
                                        <span class="text-muted">None</span>
                                    }
                                    else
                                    {
                                        <div class="admin-timer-state-list">
                                            @foreach (var timer in candidate.TimerBoundaries)
                                            {
                                                <span class="admin-timer-state">
                                                    <StatusBadge Status="@(timer.Eligible ? "ready" : "warning")" Text="@($"Boundary #{timer.BoundaryNodeId} · {timer.Status ?? "missing"}")" />
                                                    <small>@TimerStateDetail(timer)</small>
                                                </span>
                                            }
                                        </div>
                                    }
                                </td>
                                <td>@candidate.PositionUpdatedAt.ToLocalTime().ToString("g")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="pagination-bar">
                <span class="pagination-copy">Page @candidatePage of @CandidateTotalPages · @candidates.TotalCount.ToString("N0") total</span>
                <div class="d-flex gap-2">
                    <button class="btn btn-sm btn-outline-secondary" disabled="@(candidateLoading || candidatePage <= 1)" @onclick="PreviousCandidatePageAsync">Previous</button>
                    <button class="btn btn-sm btn-outline-secondary" disabled="@(candidateLoading || candidatePage >= CandidateTotalPages)" @onclick="NextCandidatePageAsync">Next</button>
                </div>
            </div>
        }
    </section>

    <section class="panel mb-3" aria-labelledby="admin-action-heading">
        <div class="section-heading">
            <div>
                <h2 id="admin-action-heading">4. Choose one authored action</h2>
                <p>Task actions and attached timer-boundary actions are shown separately. Their authorization and selected-flow conditions are informational only.</p>
            </div>
        </div>

        @if (SelectedSourceNode is null)
        {
            <div class="alert alert-secondary mb-0">Choose a workflow version and user-task node first.</div>
        }
        else if (SourceActions.Count == 0)
        {
            <div class="alert alert-secondary mb-0">This node has no selectable non-default task flow or attached timer-boundary action.</div>
        }
        else
        {
            @if (DirectActions.Count > 0)
            {
                <div class="admin-action-group">
                    <h3>Task actions</h3>
                    <div class="admin-action-grid">
                        @foreach (var action in DirectActions)
                        {
                            @ActionCard(action)
                        }
                    </div>
                </div>
            }
            @if (TimerActions.Count > 0)
            {
                <div class="admin-action-group mt-3">
                    <h3>Timer boundary actions</h3>
                    <div class="admin-action-grid">
                        @foreach (var action in TimerActions)
                        {
                            @ActionCard(action)
                        }
                    </div>
                </div>
            }

            @if (RequiresMultiInstanceMode)
            {
                <fieldset class="admin-mi-mode mt-3">
                    <legend>Multi-instance action mode</legend>
                    <label class="selection-mode-card">
                        <input type="radio" name="admin-mi-mode" value="@AdministrativeActionMultiInstanceModes.ForceParent"
                               checked="@(multiInstanceMode == AdministrativeActionMultiInstanceModes.ForceParent)"
                               @onchange="_ => SetMultiInstanceMode(AdministrativeActionMultiInstanceModes.ForceParent)" />
                        <span><strong>Force parent</strong><small>Cancel unfinished children, preserve completed child evidence, and route the parent once.</small></span>
                    </label>
                    <label class="selection-mode-card">
                        <input type="radio" name="admin-mi-mode" value="@AdministrativeActionMultiInstanceModes.CompleteAllChildren"
                               checked="@(multiInstanceMode == AdministrativeActionMultiInstanceModes.CompleteAllChildren)"
                               @onchange="_ => SetMultiInstanceMode(AdministrativeActionMultiInstanceModes.CompleteAllChildren)" />
                        <span><strong>Complete all unfinished children</strong><small>Record the selected flow for every unfinished child, then route the parent through it exactly once.</small></span>
                    </label>
                </fieldset>
            }
            else if (SelectedAction?.ActionKind == AdministrativeActionKinds.TimerBoundary && SelectedSourceNode.IsMultiInstance)
            {
                <div class="alert alert-danger mt-3 mb-0">Timer override mode is fixed: all unfinished multi-instance children are interrupted before the boundary flow is traversed.</div>
            }
        }
    </section>

    <section class="panel mb-3" aria-labelledby="admin-input-heading">
        <div class="section-heading">
            <div><h2 id="admin-input-heading">5. Provide common input and prepare</h2><p>One optional reason and one flow-variable payload apply to every selected position.</p></div>
        </div>
        <div class="row g-3">
            <div class="col-lg-6">
                <label class="form-label" for="admin-reason">Audit reason (optional)</label>
                <textarea id="admin-reason" class="form-control" rows="6" maxlength="1000" @bind="reason" @bind:event="oninput" placeholder="Why is this administrative override needed?"></textarea>
                <div class="form-text">When supplied, the reason must be 1–1,000 characters and is retained with the batch audit.</div>
            </div>
            <div class="col-lg-6">
                <label class="form-label" for="admin-common-variables">Common flow variables (JSON object)</label>
                <textarea id="admin-common-variables" class="form-control font-monospace" rows="6"
                          disabled="@(SelectedAction?.ActionKind == AdministrativeActionKinds.TimerBoundary)"
                          @bind="commonVariablesJson" @bind:event="oninput" placeholder="{}"></textarea>
                <div class="form-text">
                    @if (SelectedAction is null)
                    {
                        <text>Choose an action to see its input contract.</text>
                    }
                    else if (SelectedAction.ActionKind == AdministrativeActionKinds.TimerBoundary)
                    {
                        <text>Timer-boundary actions do not accept submitted variables.</text>
                    }
                    else if (SelectedAction.Variables.Count > 0)
                    {
                        <text>Authored inputs: @VariableContractLabel(SelectedAction)</text>
                    }
                    else
                    {
                        <text>This action declares no flow variables.</text>
                    }
                </div>
            </div>
        </div>
        <div class="d-flex flex-wrap align-items-center gap-3 mt-3">
            <button class="btn btn-primary" @onclick="CreateBatchAsync" disabled="@(!CanCreateBatch)">@(batchOperation ? "Submitting…" : "Prepare batch asynchronously")</button>
            <span class="text-muted small">No position moves until a ready batch is confirmed.</span>
        </div>
    </section>

    @if (currentBatch is not null)
    {
        var summary = currentBatch.Summary;
        <section class="panel panel-flush mb-3" aria-labelledby="admin-current-batch-heading">
            <div class="section-heading px-3 pt-3">
                <div>
                    <span class="page-eyebrow">Batch #@summary.Id</span>
                    <h2 id="admin-current-batch-heading">Preparation and execution</h2>
                    <p>@summary.WorkflowKey · v@summary.WorkflowVersion · definition #@summary.WorkflowDefinitionId · @ActionKindLabel(summary.ActionKind) flow #@summary.FlowId</p>
                </div>
                <div class="d-flex flex-wrap gap-2 align-items-center">
                    <StatusBadge Status="@summary.Status" />
                    <button class="btn btn-sm btn-outline-secondary" @onclick="RefreshCurrentBatchAsync" disabled="@refreshingBatch"><AppIcon Name="refresh" /> Refresh</button>
                </div>
            </div>
            <div class="summary-grid px-3 pb-3">
                <div class="summary-item"><span>Positions</span><strong>@summary.TotalItemCount.ToString("N0")</strong></div>
                <div class="summary-item"><span>Affected tasks</span><strong>@summary.TotalAffectedTaskCount.ToString("N0")</strong></div>
                <div class="summary-item"><span>Eligible</span><strong>@summary.EligibleItemCount.ToString("N0")</strong></div>
                <div class="summary-item"><span>Ineligible</span><strong>@summary.IneligibleItemCount.ToString("N0")</strong></div>
                <div class="summary-item"><span>Succeeded</span><strong>@summary.SucceededItemCount.ToString("N0")</strong></div>
                <div class="summary-item"><span>Queued</span><strong>@summary.QueuedItemCount.ToString("N0")</strong></div>
                <div class="summary-item"><span>Skipped</span><strong>@summary.SkippedItemCount.ToString("N0")</strong></div>
                <div class="summary-item"><span>Failed</span><strong>@summary.FailedItemCount.ToString("N0")</strong></div>
                <div class="summary-item"><span>Cancelled</span><strong>@summary.CancelledItemCount.ToString("N0")</strong></div>
            </div>
            <div class="border-top px-3 py-3">
                <h3 class="h6">Frozen request</h3>
                <dl class="row mb-2">
                    <dt class="col-md-2">Source</dt><dd class="col-md-10">@summary.SourceNodeName · node #@summary.SourceNodeId</dd>
                    <dt class="col-md-2">Action</dt><dd class="col-md-10">@ActionLabel(currentBatch.Action)</dd>
                    <dt class="col-md-2">MI mode</dt><dd class="col-md-10">@(summary.MultiInstanceMode is null ? "Not applicable" : MultiInstanceModeLabel(summary.MultiInstanceMode))</dd>
                    <dt class="col-md-2">Reason</dt><dd class="col-md-10">@(string.IsNullOrWhiteSpace(summary.Reason) ? "Not provided" : summary.Reason)</dd>
                    <dt class="col-md-2">Prepared by</dt><dd class="col-md-10">@summary.PreparedBy (@RoleSnapshot(currentBatch.PreparedByRoles))</dd>
                    <dt class="col-md-2">Confirmed by</dt><dd class="col-md-10">@(summary.ConfirmedBy is null ? "Not confirmed" : $"{summary.ConfirmedBy} ({RoleSnapshot(currentBatch.ConfirmedByRoles)})")</dd>
                </dl>
                <div class="d-flex flex-wrap gap-3">
                    <details><summary class="section-link">Common variables</summary><pre class="admin-json mt-2">@FormatJson(JsonSerializer.SerializeToElement(currentBatch.CommonVariables))</pre></details>
                    <details><summary class="section-link">Selection snapshot</summary><pre class="admin-json mt-2">@FormatJson(currentBatch.Selection)</pre></details>
                </div>
            </div>
            @if (currentBatch.Issues is not null)
            {
                <div class="px-3 pb-3"><details><summary class="section-link">Batch preparation issues</summary><pre class="admin-json mt-2">@FormatJson(currentBatch.Issues)</pre></details></div>
            }
            <div class="d-flex flex-wrap gap-2 px-3 pb-3">
                @if (CanConfirmCurrentBatch)
                {
                    <button class="btn btn-primary" @onclick="ConfirmCurrentBatchAsync" disabled="@batchOperation">Confirm @summary.EligibleItemCount.ToString("N0") eligible positions / @summary.TotalAffectedTaskCount.ToString("N0") affected tasks</button>
                }
                @if (CanCancelCurrentBatch)
                {
                    <input class="form-control admin-cancellation-input" maxlength="1000" @bind="cancellationReason" placeholder="Cancellation reason (optional)" aria-label="Cancellation reason" />
                    <button class="btn btn-outline-danger" @onclick="CancelCurrentBatchAsync" disabled="@batchOperation">Cancel unstarted positions</button>
                }
            </div>

            <div class="border-top px-3 pt-3">
                <div class="section-heading">
                    <div><h3 class="h6 mb-0">Paged item results</h3><p>@(batchItems is null ? "Loading items…" : $"{batchItems.TotalCount:N0} matching items")</p></div>
                    <select class="form-select admin-status-filter" value="@batchItemStatus" @onchange="OnBatchItemStatusChangedAsync" aria-label="Filter batch items by status">
                        @foreach (var option in BatchItemStatusOptions) { <option value="@option.Value">@option.Label</option> }
                    </select>
                </div>
            </div>
            @if (batchItems is null)
            {
                <div class="p-3"><div class="skeleton"></div></div>
            }
            else if (batchItems.Items.Count == 0)
            {
                <div class="px-3 pb-3"><EmptyState Icon="inbox" Title="No items in this view" Description="Preparation may still be running, or no item has the selected status." /></div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table align-middle">
                        <thead><tr><th>Item</th><th>Position / instance</th><th>Action fence</th><th>Affected</th><th>Status</th><th>Result / issue</th><th>Updated</th></tr></thead>
                        <tbody>
                            @foreach (var item in batchItems.Items)
                            {
                                <tr>
                                    <td>#@item.Id</td>
                                    <td><a href="@($"instances/{item.InstanceId}")">Instance #@item.InstanceId</a><span class="data-subtitle">@PositionKindLabel(item.PositionKind) #@item.PositionId · token #@item.TokenId</span></td>
                                    <td>Definition #@item.WorkflowDefinitionId · node #@item.SourceNodeId<span class="data-subtitle">Flow #@item.FlowId@(item.TimerSubscriptionId is long timerId ? $" · timer subscription #{timerId}" : string.Empty)</span></td>
                                    <td>@item.AffectedTaskCount.ToString("N0") task(s)</td>
                                    <td><StatusBadge Status="@item.Status" /></td>
                                    <td class="admin-result-cell">
                                        @if (!string.IsNullOrWhiteSpace(item.ErrorDescription))
                                        {
                                            <span class="text-danger">@item.ErrorDescription</span>
                                        }
                                        else if (item.Issues is not null)
                                        {
                                            <details><summary class="section-link">Issues</summary><pre class="admin-json mt-1">@FormatJson(item.Issues)</pre></details>
                                        }
                                        else if (item.Result is not null)
                                        {
                                            <details><summary class="section-link">Result</summary><pre class="admin-json mt-1">@FormatJson(item.Result)</pre></details>
                                        }
                                        else
                                        {
                                            <span class="text-muted">—</span>
                                        }
                                    </td>
                                    <td>@item.UpdatedAt.ToLocalTime().ToString("g")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="pagination-bar">
                    <span class="pagination-copy">Page @batchItemPage of @BatchItemTotalPages</span>
                    <div class="d-flex gap-2">
                        <button class="btn btn-sm btn-outline-secondary" disabled="@(batchItemPage <= 1 || refreshingBatch)" @onclick="PreviousBatchItemPageAsync">Previous</button>
                        <button class="btn btn-sm btn-outline-secondary" disabled="@(batchItemPage >= BatchItemTotalPages || refreshingBatch)" @onclick="NextBatchItemPageAsync">Next</button>
                    </div>
                </div>
            }
        </section>
    }

    <section class="panel panel-flush" aria-labelledby="admin-batches-heading">
        <div class="section-heading px-3 pt-3">
            <div><h2 id="admin-batches-heading">Recent batches</h2><p>Executed administrative audits are retained and can be reopened.</p></div>
            <select class="form-select admin-status-filter" value="@batchListStatus" @onchange="OnBatchListStatusChangedAsync" aria-label="Filter batches by status">
                @foreach (var option in BatchStatusOptions) { <option value="@option.Value">@option.Label</option> }
            </select>
        </div>
        @if (batchList is null)
        {
            <div class="p-3"><div class="skeleton" role="status"></div></div>
        }
        else if (batchList.Items.Count == 0)
        {
            <div class="px-3 pb-3"><EmptyState Icon="jobs" Title="No administrative batches" Description="No batch matches the selected status." /></div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table align-middle">
                    <thead><tr><th>Batch</th><th>Workflow position</th><th>Action</th><th>Prepared by</th><th>Progress</th><th>Status</th><th>Updated</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var item in batchList.Items)
                        {
                            <tr class="@(currentBatch?.Summary.Id == item.Id ? "table-active" : null)">
                                <td>#@item.Id</td>
                                <td>@item.WorkflowKey · v@item.WorkflowVersion<span class="data-subtitle">Definition #@item.WorkflowDefinitionId · @item.SourceNodeName (#@item.SourceNodeId)</span></td>
                                <td>@ActionKindLabel(item.ActionKind) · flow #@item.FlowId<span class="data-subtitle">@(item.MultiInstanceMode is null ? "Standard position" : MultiInstanceModeLabel(item.MultiInstanceMode))</span></td>
                                <td>@item.PreparedBy</td>
                                <td>@item.SucceededItemCount.ToString("N0") / @item.TotalItemCount.ToString("N0")<span class="data-subtitle">@item.TotalAffectedTaskCount.ToString("N0") affected · @item.FailedItemCount.ToString("N0") failed</span></td>
                                <td><StatusBadge Status="@item.Status" /></td>
                                <td>@item.UpdatedAt.ToLocalTime().ToString("g")</td>
                                <td class="text-end"><button class="btn btn-sm btn-outline-primary" @onclick="() => OpenBatchAsync(item.Id)">Open</button></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="pagination-bar">
                <span class="pagination-copy">Page @batchListPage of @BatchListTotalPages · @batchList.TotalCount.ToString("N0") batches</span>
                <div class="d-flex gap-2">
                    <button class="btn btn-sm btn-outline-secondary" disabled="@(batchListPage <= 1 || loadingBatches)" @onclick="PreviousBatchListPageAsync">Previous</button>
                    <button class="btn btn-sm btn-outline-secondary" disabled="@(batchListPage >= BatchListTotalPages || loadingBatches)" @onclick="NextBatchListPageAsync">Next</button>
                </div>
            </div>
        }
    </section>
}

@code {
    [SupplyParameterFromQuery(Name = "batchId")]
    public long? RequestedBatchId { get; set; }

    private const int CandidatePageSize = 50;
    private const int BatchListPageSize = 25;
    private const int BatchItemPageSize = 50;
    private static readonly JsonSerializerOptions JsonOptions = new(JsonSerializerDefaults.Web) { WriteIndented = true };
    private static readonly (string Value, string Label)[] BatchStatusOptions =
    [
        ("", "All statuses"), ("preparing", "Preparing"), ("ready", "Ready"), ("queued", "Queued"),
        ("running", "Running"), ("completed", "Completed"), ("completedWithIssues", "Completed with issues"),
        ("cancelled", "Cancelled"), ("failed", "Failed")
    ];
    private static readonly (string Value, string Label)[] BatchItemStatusOptions =
    [
        ("", "All item statuses"), ("preparing", "Preparing"), ("eligible", "Eligible"),
        ("ineligible", "Ineligible"), ("queued", "Queued"), ("succeeded", "Succeeded"),
        ("skipped", "Skipped"), ("failed", "Failed"), ("cancelled", "Cancelled")
    ];

    private IReadOnlyList<WorkflowSummaryDto>? workflowFamilies;
    private IReadOnlyList<WorkflowSummaryDto> administrativeWorkflowCatalog = [];
    private IReadOnlyList<WorkflowSummaryDto> workflowVersions = [];
    private IReadOnlyList<AdministrativeActionSourceNodeDto> sourceNodes = [];
    private IReadOnlyList<AdministrativeActionSummaryDto> workflowActions = [];
    private string? selectedWorkflowKey;
    private long? selectedWorkflowDefinitionId;
    private int? selectedSourceNodeId;
    private string? selectedActionKey;
    private string multiInstanceMode = AdministrativeActionMultiInstanceModes.ForceParent;
    private long? candidatePositionId;
    private long? candidateInstanceId;
    private string? candidateBusinessKey;
    private string? candidateVariableFilterJson;
    private string? candidateVariableFilterError;
    private PagedResult<AdministrativeActionCandidateDto>? candidates;
    private AdministrativeActionCandidateSearchRequest? appliedCandidateSearch;
    private readonly HashSet<PositionSelectionKey> explicitlySelectedPositions = [];
    private readonly HashSet<PositionSelectionKey> excludedPositions = [];
    private readonly Dictionary<PositionSelectionKey, int> knownAffectedTaskCounts = [];
    private readonly Dictionary<(PositionSelectionKey Position, int BoundaryNodeId), bool> knownTimerEligibility = [];
    private bool allMatchingSelection;
    private int candidatePage = 1;
    private bool candidateFiltersDirty;
    private string reason = string.Empty;
    private string commonVariablesJson = "{}";
    private string? draftIdempotencyKey;
    private AdministrativeActionBatchDetailDto? currentBatch;
    private PagedResult<AdministrativeActionBatchItemDto>? batchItems;
    private string? batchItemStatus;
    private int batchItemPage = 1;
    private PagedResult<AdministrativeActionBatchSummaryDto>? batchList;
    private string? batchListStatus;
    private int batchListPage = 1;
    private string? cancellationReason;
    private string? error;
    private string? success;
    private bool loading;
    private bool loadingDefinition;
    private bool candidateLoading;
    private bool batchOperation;
    private bool refreshingBatch;
    private bool loadingBatches;
    private readonly CancellationTokenSource pollCancellation = new();
    private Task? pollTask;

    private string SelectedWorkflowDefinitionIdText => selectedWorkflowDefinitionId?.ToString() ?? string.Empty;
    private string SelectedSourceNodeIdText => selectedSourceNodeId?.ToString() ?? string.Empty;
    private WorkflowSummaryDto? SelectedWorkflowVersion => workflowVersions.FirstOrDefault(version => version.Id == selectedWorkflowDefinitionId);
    private AdministrativeActionSourceNodeDto? SelectedSourceNode => sourceNodes.FirstOrDefault(node => node.NodeId == selectedSourceNodeId);
    private IReadOnlyList<AdministrativeActionSummaryDto> SourceActions => workflowActions.Where(action => action.SourceNodeId == selectedSourceNodeId).ToArray();
    private IReadOnlyList<AdministrativeActionSummaryDto> DirectActions => SourceActions.Where(action => action.ActionKind == AdministrativeActionKinds.DirectFlow).ToArray();
    private IReadOnlyList<AdministrativeActionSummaryDto> TimerActions => SourceActions.Where(action => action.ActionKind == AdministrativeActionKinds.TimerBoundary).ToArray();
    private AdministrativeActionSummaryDto? SelectedAction => SourceActions.FirstOrDefault(action => ActionKey(action) == selectedActionKey);
    private bool RequiresMultiInstanceMode => SelectedSourceNode?.IsMultiInstance == true && SelectedAction?.ActionKind == AdministrativeActionKinds.DirectFlow;
    private bool CanSearchCandidates => !candidateLoading && selectedWorkflowDefinitionId is > 0 && selectedSourceNodeId is > 0;
    private long SelectedCandidateCount => allMatchingSelection
        ? Math.Max(0, (candidates?.TotalCount ?? 0) - excludedPositions.Count)
        : explicitlySelectedPositions.Count;
    private int ExplicitAffectedTaskCount => explicitlySelectedPositions.Sum(key => knownAffectedTaskCounts.GetValueOrDefault(key));
    private bool CanCreateBatch => !batchOperation && !candidateFiltersDirty && SelectedCandidateCount > 0
        && SelectedAction is not null && appliedCandidateSearch is not null
        && IsActionSelectable(SelectedAction)
        && (string.IsNullOrWhiteSpace(reason) || reason.Trim().EnumerateRunes().Count() <= 1000)
        && (!RequiresMultiInstanceMode || AdministrativeActionMultiInstanceModes.IsKnown(multiInstanceMode));
    private int CandidateTotalPages => TotalPages(candidates?.TotalCount ?? 0, CandidatePageSize);
    private int BatchItemTotalPages => TotalPages(batchItems?.TotalCount ?? 0, BatchItemPageSize);
    private int BatchListTotalPages => TotalPages(batchList?.TotalCount ?? 0, BatchListPageSize);
    private bool CanConfirmCurrentBatch => currentBatch?.Summary.Status.Equals("ready", StringComparison.OrdinalIgnoreCase) == true;
    private bool CanCancelCurrentBatch => currentBatch is not null && IsCancellable(currentBatch.Summary.Status);
    private string CandidateSummary => candidateFiltersDirty
        ? "Filters changed. Search again to establish a new server-side result."
        : candidateLoading ? "Searching active execution positions…"
        : candidates is null ? "No search has run yet."
        : $"{candidates.TotalCount:N0} running position(s)";

    protected override async Task OnInitializedAsync()
    {
        Token.Changed += OnTokenChanged;
        pollTask = PollCurrentBatchAsync(pollCancellation.Token);
        if (Token.HasToken) await LoadInitialAsync();
    }

    private async Task LoadInitialAsync()
    {
        try
        {
            loading = true;
            error = null;
            administrativeWorkflowCatalog = await Api.GetAdministrativeActionWorkflowCatalogAsync();
            workflowFamilies = administrativeWorkflowCatalog
                .GroupBy(workflow => workflow.WorkflowKey, StringComparer.OrdinalIgnoreCase)
                .Select(group => group.OrderByDescending(workflow => workflow.Version).First())
                .OrderBy(workflow => workflow.Name, StringComparer.OrdinalIgnoreCase)
                .ToArray();
            selectedWorkflowKey = workflowFamilies.FirstOrDefault()?.WorkflowKey;
            if (!string.IsNullOrWhiteSpace(selectedWorkflowKey)) await LoadWorkflowFamilyAsync(selectedWorkflowKey);
            await LoadBatchListAsync();
            if (RequestedBatchId is > 0) await OpenBatchAsync(RequestedBatchId.Value);
        }
        catch (Exception ex)
        {
            error = ex.Message;
            workflowFamilies ??= [];
        }
        finally
        {
            loading = false;
        }
    }

    private async Task RefreshAllAsync()
    {
        if (!Token.HasToken) return;
        var openedBatchId = currentBatch?.Summary.Id;
        await LoadInitialAsync();
        if (openedBatchId is long batchId) await OpenBatchAsync(batchId);
    }

    private async Task OnWorkflowFamilyChangedAsync(ChangeEventArgs args)
    {
        selectedWorkflowKey = args.Value?.ToString();
        if (!string.IsNullOrWhiteSpace(selectedWorkflowKey)) await LoadWorkflowFamilyAsync(selectedWorkflowKey);
    }

    private async Task LoadWorkflowFamilyAsync(string workflowKey)
    {
        workflowVersions = administrativeWorkflowCatalog
            .Where(version => string.Equals(version.WorkflowKey, workflowKey, StringComparison.OrdinalIgnoreCase))
            .OrderByDescending(version => version.Version)
            .ToArray();
        selectedWorkflowDefinitionId = workflowVersions.FirstOrDefault()?.Id;
        await LoadSelectedDefinitionAsync();
    }

    private async Task OnWorkflowVersionChangedAsync(ChangeEventArgs args)
    {
        selectedWorkflowDefinitionId = long.TryParse(args.Value?.ToString(), out var definitionId) ? definitionId : null;
        await LoadSelectedDefinitionAsync();
    }

    private async Task LoadSelectedDefinitionAsync()
    {
        try
        {
            loadingDefinition = true;
            error = null;
            sourceNodes = selectedWorkflowDefinitionId is long definitionId
                ? await Api.GetWorkflowAdministrativeActionNodesAsync(definitionId)
                : [];
            selectedSourceNodeId = sourceNodes.FirstOrDefault()?.NodeId;
            await LoadSelectedNodeActionsAsync();
        }
        catch (Exception ex)
        {
            error = ex.Message;
            workflowActions = [];
            sourceNodes = [];
            selectedSourceNodeId = null;
            selectedActionKey = null;
        }
        finally
        {
            loadingDefinition = false;
            ResetCandidateResults();
        }
    }

    private async Task OnSourceNodeChangedAsync(ChangeEventArgs args)
    {
        selectedSourceNodeId = int.TryParse(args.Value?.ToString(), out var nodeId) ? nodeId : null;
        await LoadSelectedNodeActionsAsync();
    }

    private async Task LoadSelectedNodeActionsAsync()
    {
        try
        {
            workflowActions = selectedWorkflowDefinitionId is long definitionId && selectedSourceNodeId is int nodeId
                ? await Api.GetWorkflowAdministrativeActionsAsync(definitionId, nodeId)
                : [];
            SelectDefaultAction();
        }
        catch (Exception ex)
        {
            error = ex.Message;
            workflowActions = [];
            selectedActionKey = null;
        }
        finally
        {
            ResetCandidateResults();
        }
    }

    private void SelectDefaultAction()
    {
        selectedActionKey = SourceActions.FirstOrDefault() is { } action ? ActionKey(action) : null;
        multiInstanceMode = AdministrativeActionMultiInstanceModes.ForceParent;
        commonVariablesJson = "{}";
        draftIdempotencyKey = null;
    }

    private void SelectAction(AdministrativeActionSummaryDto action)
    {
        if (!IsActionSelectable(action)) return;
        selectedActionKey = ActionKey(action);
        if (action.ActionKind == AdministrativeActionKinds.TimerBoundary) commonVariablesJson = "{}";
        draftIdempotencyKey = null;
    }

    private void SetMultiInstanceMode(string mode)
    {
        multiInstanceMode = mode;
        draftIdempotencyKey = null;
    }

    private void MarkCandidateFiltersDirty()
    {
        if (candidates is not null) candidateFiltersDirty = true;
        candidatePage = 1;
        ClearSelection();
    }

    private Task OnCandidateVariableFilterChanged(string? value)
    {
        candidateVariableFilterJson = value;
        candidateVariableFilterError = null;
        MarkCandidateFiltersDirty();
        return Task.CompletedTask;
    }

    private async Task ClearCandidateFiltersAsync()
    {
        candidatePositionId = null;
        candidateInstanceId = null;
        candidateBusinessKey = null;
        candidateVariableFilterJson = null;
        candidateVariableFilterError = null;
        candidatePage = 1;
        await SearchCandidatesAsync();
    }

    private async Task SearchCandidatesAsync()
    {
        if (!CanSearchCandidates) return;
        if (!TryParseOptionalJson(candidateVariableFilterJson, out var variableFilter, out candidateVariableFilterError)) return;
        try
        {
            candidateLoading = true;
            error = null;
            success = null;
            var request = BuildCandidateSearch(candidatePage, CandidatePageSize, variableFilter);
            candidates = await Api.SearchAdministrativeActionCandidatesAsync(request);
            appliedCandidateSearch = BuildCandidateSearch(null, null, variableFilter);
            candidateFiltersDirty = false;
            knownAffectedTaskCounts.Clear();
            knownTimerEligibility.Clear();
            ClearSelection();
            RememberAffectedTaskCounts(candidates.Items);
        }
        catch (Exception ex)
        {
            error = ex.Message;
            candidates = null;
            appliedCandidateSearch = null;
        }
        finally
        {
            candidateLoading = false;
        }
    }

    private async Task LoadCandidatePageAsync(int page)
    {
        if (appliedCandidateSearch is null) return;
        try
        {
            candidateLoading = true;
            candidatePage = page;
            candidates = await Api.SearchAdministrativeActionCandidatesAsync(
                appliedCandidateSearch with { Page = candidatePage, PageSize = CandidatePageSize });
            RememberAffectedTaskCounts(candidates.Items);
        }
        catch (Exception ex) { error = ex.Message; }
        finally { candidateLoading = false; }
    }

    private AdministrativeActionCandidateSearchRequest BuildCandidateSearch(int? page, int? pageSize, JsonElement? variableFilter) => new()
    {
        WorkflowDefinitionId = selectedWorkflowDefinitionId ?? 0,
        SourceNodeId = selectedSourceNodeId ?? 0,
        PositionId = candidatePositionId,
        InstanceId = candidateInstanceId,
        BusinessKey = string.IsNullOrWhiteSpace(candidateBusinessKey) ? null : candidateBusinessKey.Trim(),
        VariableFilter = variableFilter,
        IncludeVariables = true,
        Page = page,
        PageSize = pageSize
    };

    private Task PreviousCandidatePageAsync() => LoadCandidatePageAsync(Math.Max(1, candidatePage - 1));
    private Task NextCandidatePageAsync() => LoadCandidatePageAsync(Math.Min(CandidateTotalPages, candidatePage + 1));

    private bool IsCandidateSelected(PositionSelectionKey key) => allMatchingSelection
        ? !excludedPositions.Contains(key)
        : explicitlySelectedPositions.Contains(key);

    private void ToggleCandidate(AdministrativeActionCandidateDto candidate)
    {
        var key = PositionKey(candidate);
        if (allMatchingSelection)
        {
            if (!excludedPositions.Add(key)) excludedPositions.Remove(key);
        }
        else if (!explicitlySelectedPositions.Add(key)) explicitlySelectedPositions.Remove(key);
        EnsureSelectedTimerActionAvailable();
        draftIdempotencyKey = null;
    }

    private void SelectCurrentCandidatePage()
    {
        if (candidates is null) return;
        if (allMatchingSelection)
        {
            foreach (var candidate in candidates.Items) excludedPositions.Remove(PositionKey(candidate));
        }
        else
        {
            foreach (var candidate in candidates.Items) explicitlySelectedPositions.Add(PositionKey(candidate));
        }
        EnsureSelectedTimerActionAvailable();
        draftIdempotencyKey = null;
    }

    private void SetSelectionMode(bool allMatching)
    {
        allMatchingSelection = allMatching;
        explicitlySelectedPositions.Clear();
        excludedPositions.Clear();
        EnsureSelectedTimerActionAvailable();
        draftIdempotencyKey = null;
    }

    private void ClearSelection()
    {
        explicitlySelectedPositions.Clear();
        excludedPositions.Clear();
        EnsureSelectedTimerActionAvailable();
        draftIdempotencyKey = null;
    }

    private void RememberAffectedTaskCounts(IEnumerable<AdministrativeActionCandidateDto> page)
    {
        foreach (var candidate in page)
        {
            var position = PositionKey(candidate);
            knownAffectedTaskCounts[position] = candidate.AffectedTaskCount;
            foreach (var timer in candidate.TimerBoundaries)
            {
                knownTimerEligibility[(position, timer.BoundaryNodeId)] = timer.Eligible;
            }
        }
    }

    private async Task CreateBatchAsync()
    {
        if (!CanCreateBatch || appliedCandidateSearch is null || SelectedAction is null) return;
        if (!TryParseVariables(commonVariablesJson, out var variables, out var parseError))
        {
            error = parseError;
            return;
        }
        try
        {
            batchOperation = true;
            error = null;
            success = null;
            draftIdempotencyKey ??= Guid.NewGuid().ToString("N");
            var selection = allMatchingSelection
                ? new AdministrativeActionBatchSelectionDto(
                    AdministrativeActionBatchSelectionModes.AllMatching,
                    null,
                    appliedCandidateSearch,
                    excludedPositions.OrderBy(key => key.Kind, StringComparer.Ordinal).ThenBy(key => key.Id).Select(PositionReference).ToArray())
                : new AdministrativeActionBatchSelectionDto(
                    AdministrativeActionBatchSelectionModes.Explicit,
                    explicitlySelectedPositions.OrderBy(key => key.Kind, StringComparer.Ordinal).ThenBy(key => key.Id).Select(PositionReference).ToArray(),
                    null,
                    null);
            var action = SelectedAction;
            currentBatch = await Api.CreateAdministrativeActionBatchAsync(new CreateAdministrativeActionBatchRequest(
                action.WorkflowDefinitionId,
                action.SourceNodeId,
                action.ActionKind,
                action.FlowId,
                action.BoundaryNodeId,
                RequiresMultiInstanceMode ? multiInstanceMode : null,
                string.IsNullOrWhiteSpace(reason) ? null : reason.Trim(),
                action.ActionKind == AdministrativeActionKinds.TimerBoundary ? null : variables,
                selection,
                draftIdempotencyKey));
            draftIdempotencyKey = null;
            batchItemPage = 1;
            batchItemStatus = null;
            await LoadBatchItemsAsync();
            await LoadBatchListAsync();
            success = $"Batch #{currentBatch.Summary.Id} was frozen and queued for asynchronous preparation.";
        }
        catch (Exception ex) { error = ex.Message; }
        finally { batchOperation = false; }
    }

    private async Task OpenBatchAsync(long batchId)
    {
        try
        {
            error = null;
            currentBatch = await Api.GetAdministrativeActionBatchAsync(batchId)
                ?? throw new InvalidOperationException($"Administrative batch #{batchId} was not found.");
            batchItemPage = 1;
            batchItemStatus = null;
            cancellationReason = null;
            await LoadBatchItemsAsync();
        }
        catch (Exception ex) { error = ex.Message; }
    }

    private async Task RefreshCurrentBatchAsync()
    {
        if (currentBatch is null || refreshingBatch) return;
        try
        {
            refreshingBatch = true;
            var refreshed = await Api.GetAdministrativeActionBatchAsync(currentBatch.Summary.Id);
            if (refreshed is not null) currentBatch = refreshed;
            await LoadBatchItemsAsync();
            await LoadBatchListAsync();
        }
        catch (Exception ex) { error = ex.Message; }
        finally { refreshingBatch = false; }
    }

    private async Task ConfirmCurrentBatchAsync()
    {
        if (!CanConfirmCurrentBatch || currentBatch is null) return;
        try
        {
            batchOperation = true;
            error = null;
            var expected = currentBatch.Summary;
            currentBatch = await Api.ConfirmAdministrativeActionBatchAsync(expected.Id,
                new ConfirmAdministrativeActionBatchRequest(
                    expected.EligibleItemCount,
                    expected.TotalAffectedTaskCount,
                    expected.UpdatedAt));
            success = $"Batch #{expected.Id} was confirmed. Eligible positions are queued for independent execution.";
            await LoadBatchItemsAsync();
            await LoadBatchListAsync();
        }
        catch (Exception ex) { error = ex.Message; }
        finally { batchOperation = false; }
    }

    private async Task CancelCurrentBatchAsync()
    {
        if (!CanCancelCurrentBatch || currentBatch is null) return;
        try
        {
            batchOperation = true;
            error = null;
            var id = currentBatch.Summary.Id;
            currentBatch = await Api.CancelAdministrativeActionBatchAsync(id,
                new CancelAdministrativeActionBatchRequest(string.IsNullOrWhiteSpace(cancellationReason) ? null : cancellationReason.Trim()));
            success = $"Batch #{id} was cancelled. Completed actions were not reversed.";
            await LoadBatchItemsAsync();
            await LoadBatchListAsync();
        }
        catch (Exception ex) { error = ex.Message; }
        finally { batchOperation = false; }
    }

    private async Task LoadBatchItemsAsync()
    {
        if (currentBatch is null) return;
        batchItems = await Api.GetAdministrativeActionBatchItemsAsync(currentBatch.Summary.Id, batchItemStatus, batchItemPage, BatchItemPageSize);
    }

    private async Task OnBatchItemStatusChangedAsync(ChangeEventArgs args)
    {
        batchItemStatus = args.Value?.ToString();
        batchItemPage = 1;
        await LoadBatchItemsAsync();
    }

    private async Task PreviousBatchItemPageAsync() { batchItemPage = Math.Max(1, batchItemPage - 1); await LoadBatchItemsAsync(); }
    private async Task NextBatchItemPageAsync() { batchItemPage = Math.Min(BatchItemTotalPages, batchItemPage + 1); await LoadBatchItemsAsync(); }

    private async Task LoadBatchListAsync()
    {
        try
        {
            loadingBatches = true;
            batchList = await Api.GetAdministrativeActionBatchesAsync(new AdministrativeActionBatchSearchRequest
            {
                Status = string.IsNullOrWhiteSpace(batchListStatus) ? null : batchListStatus,
                Page = batchListPage,
                PageSize = BatchListPageSize
            });
        }
        finally { loadingBatches = false; }
    }

    private async Task OnBatchListStatusChangedAsync(ChangeEventArgs args)
    {
        batchListStatus = args.Value?.ToString();
        batchListPage = 1;
        await LoadBatchListAsync();
    }

    private async Task PreviousBatchListPageAsync() { batchListPage = Math.Max(1, batchListPage - 1); await LoadBatchListAsync(); }
    private async Task NextBatchListPageAsync() { batchListPage = Math.Min(BatchListTotalPages, batchListPage + 1); await LoadBatchListAsync(); }

    private async Task PollCurrentBatchAsync(CancellationToken cancellationToken)
    {
        try
        {
            using var timer = new PeriodicTimer(TimeSpan.FromSeconds(3));
            while (await timer.WaitForNextTickAsync(cancellationToken))
            {
                if (currentBatch is null || !IsLive(currentBatch.Summary) || refreshingBatch) continue;
                await InvokeAsync(RefreshCurrentBatchAsync);
            }
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested) { }
    }

    private void OnTokenChanged() => _ = InvokeAsync(async () =>
    {
        if (Token.HasToken) await LoadInitialAsync();
        else
        {
            workflowFamilies = null;
            currentBatch = null;
            batchList = null;
        }
        StateHasChanged();
    });

    private void ResetCandidateResults()
    {
        candidates = null;
        appliedCandidateSearch = null;
        candidatePage = 1;
        candidateFiltersDirty = false;
        knownAffectedTaskCounts.Clear();
        knownTimerEligibility.Clear();
        ClearSelection();
    }

    private RenderFragment ActionCard(AdministrativeActionSummaryDto action) => @<label class="admin-action-card @(ActionKey(action) == selectedActionKey ? "is-selected" : null)">
            <input type="radio" name="admin-action" checked="@(ActionKey(action) == selectedActionKey)"
                   disabled="@(!IsActionSelectable(action))" @onchange="_ => SelectAction(action)" />
            <span class="admin-action-copy">
                <strong>@ActionTitle(action)</strong>
                <span>@action.SourceNodeName → @action.TargetNodeName <small>(@action.TargetNodeType · flow #@action.FlowId)</small></span>
                <span class="admin-action-meta">Roles ignored: @(action.Roles.Count == 0 ? "none authored" : string.Join(", ", action.Roles))</span>
                <span class="admin-action-meta">Condition ignored: @(string.IsNullOrWhiteSpace(action.Condition) ? "none authored" : action.Condition)</span>
                @if (action.ActionKind == AdministrativeActionKinds.TimerBoundary)
                {
                    <span class="admin-action-meta">Boundary #@action.BoundaryNodeId · @TimerDefinitionLabel(action.Timer) · authored @(action.AuthoredCancelActivity == false ? "non-interrupting" : "interrupting")</span>
                    <span class="admin-action-meta text-danger">@TimerAvailabilityLabel(action)</span>
                }
                else
                {
                    <span class="admin-action-meta">Inputs: @VariableContractLabel(action)</span>
                }
            </span>
        </label>;

    private string TimerAvailabilityLabel(AdministrativeActionSummaryDto action)
    {
        if (candidates is null) return "Search positions to inspect live timer subscriptions.";
        if (!IsActionSelectable(action))
        {
            return "None of the selected positions has an active or paused subscription for this boundary.";
        }
        var states = candidates.Items
            .SelectMany(candidate => candidate.TimerBoundaries)
            .Where(timer => timer.BoundaryNodeId == action.BoundaryNodeId)
            .ToArray();
        var eligible = states.Count(timer => timer.Eligible);
        return $"{eligible:N0} of {candidates.Items.Count:N0} position(s) on this page have an active or paused subscription; preparation revalidates every selected position.";
    }

    private bool IsActionSelectable(AdministrativeActionSummaryDto action)
    {
        if (action.ActionKind != AdministrativeActionKinds.TimerBoundary) return true;
        if (action.BoundaryNodeId is not int boundaryNodeId || SelectedCandidateCount <= 0) return false;

        var selectedKnownPositions = knownAffectedTaskCounts.Keys
            .Where(IsCandidateSelected)
            .ToArray();
        if (selectedKnownPositions.Any(position =>
                knownTimerEligibility.TryGetValue((position, boundaryNodeId), out var eligible)
                && eligible))
        {
            return true;
        }

        // In all-matching mode, unseen server-side pages may still contain an
        // eligible subscription. Preparation is authoritative for those rows.
        return allMatchingSelection
            && candidates is not null
            && knownAffectedTaskCounts.Count < candidates.TotalCount;
    }

    private void EnsureSelectedTimerActionAvailable()
    {
        if (SelectedAction is { ActionKind: AdministrativeActionKinds.TimerBoundary } action
            && !IsActionSelectable(action))
        {
            selectedActionKey = null;
            commonVariablesJson = "{}";
        }
    }

    private static bool TryParseOptionalJson(string? value, out JsonElement? result, out string? parseError)
    {
        result = null;
        parseError = null;
        if (string.IsNullOrWhiteSpace(value)) return true;
        try
        {
            using var document = JsonDocument.Parse(value);
            result = document.RootElement.Clone();
            return true;
        }
        catch (JsonException ex) { parseError = $"Variable filter JSON is invalid: {ex.Message}"; return false; }
    }

    private static bool TryParseVariables(string? value, out Dictionary<string, JsonElement> variables, out string? parseError)
    {
        variables = [];
        parseError = null;
        try
        {
            using var document = JsonDocument.Parse(string.IsNullOrWhiteSpace(value) ? "{}" : value);
            if (document.RootElement.ValueKind != JsonValueKind.Object)
            {
                parseError = "Common variables must be a JSON object.";
                return false;
            }
            foreach (var property in document.RootElement.EnumerateObject()) variables[property.Name] = property.Value.Clone();
            return true;
        }
        catch (JsonException ex) { parseError = $"Common variables JSON is invalid: {ex.Message}"; return false; }
    }

    private static string ActionKey(AdministrativeActionSummaryDto action) => $"{action.ActionKind}:{action.BoundaryNodeId ?? 0}:{action.FlowId}";
    private static string ActionTitle(AdministrativeActionSummaryDto action) => string.IsNullOrWhiteSpace(action.Name)
        ? action.ActionKind == AdministrativeActionKinds.TimerBoundary ? action.BoundaryNodeName ?? $"Timer boundary #{action.BoundaryNodeId}" : $"Flow #{action.FlowId}"
        : action.Name;
    private static string ActionLabel(AdministrativeActionSummaryDto action) => $"{ActionTitle(action)} · {ActionKindLabel(action.ActionKind)} · {action.SourceNodeName} → {action.TargetNodeName} · flow #{action.FlowId}";
    private static string ActionKindLabel(string value) => value == AdministrativeActionKinds.TimerBoundary ? "Timer boundary" : "Task action";
    private static string PositionKindLabel(string value) => value == AdministrativeActionPositionKinds.MultiInstanceExecution ? "MI execution" : "User task";
    private static string MultiInstanceModeLabel(string value) => value == AdministrativeActionMultiInstanceModes.CompleteAllChildren ? "Complete all unfinished children" : "Force parent";
    private static string RoleSnapshot(IReadOnlyList<string>? roles) => roles is null || roles.Count == 0 ? "no roles" : string.Join(", ", roles);
    private static string ShortActivation(Guid activationId) => activationId.ToString("N")[..8];
    private static PositionSelectionKey PositionKey(AdministrativeActionCandidateDto candidate) => new(candidate.PositionKind, candidate.PositionId);
    private static AdministrativeActionPositionReferenceDto PositionReference(PositionSelectionKey key) => new(key.Kind, key.Id);
    private static string VariableContractLabel(AdministrativeActionSummaryDto action) => action.Variables.Count == 0
        ? "No flow variables"
        : string.Join(", ", action.Variables.OrderBy(variable => variable.Name, StringComparer.OrdinalIgnoreCase)
            .Select(variable => $"{variable.Name}:{variable.DataType}{(variable.IsArray ? "[]" : string.Empty)}{(variable.Required ? "*" : string.Empty)}"));
    private static string TimerDefinitionLabel(TimerDefinitionModel? timer) => timer is null ? "timer expression unavailable"
        : !string.IsNullOrWhiteSpace(timer.TimeDate) ? $"date {timer.TimeDate}"
        : !string.IsNullOrWhiteSpace(timer.TimeDuration) ? $"duration {timer.TimeDuration}"
        : !string.IsNullOrWhiteSpace(timer.TimeCycle) ? $"cycle {timer.TimeCycle}"
        : "timer expression unavailable";
    private static string TimerStateDetail(AdministrativeTimerBoundaryStateDto timer)
    {
        var due = timer.NextDueAt is null ? "no due time" : $"due {timer.NextDueAt.Value.ToLocalTime():g}";
        var occurrence = timer.Occurrence is null ? string.Empty : $" · occurrence {timer.Occurrence}";
        return $"{due}{occurrence}";
    }
    private static string FormatJson(JsonElement? value) => value is null ? string.Empty : JsonSerializer.Serialize(value.Value, JsonOptions);
    private static int TotalPages(long totalCount, int pageSize) => totalCount == 0 ? 1 : (int)Math.Ceiling(totalCount / (double)pageSize);
    private static bool IsCancellable(string status) => status.Equals("preparing", StringComparison.OrdinalIgnoreCase)
        || status.Equals("ready", StringComparison.OrdinalIgnoreCase)
        || status.Equals("queued", StringComparison.OrdinalIgnoreCase)
        || status.Equals("running", StringComparison.OrdinalIgnoreCase);
    private static bool IsLive(AdministrativeActionBatchSummaryDto summary) =>
        summary.Status.Equals("preparing", StringComparison.OrdinalIgnoreCase)
        || summary.Status.Equals("queued", StringComparison.OrdinalIgnoreCase)
        || summary.Status.Equals("running", StringComparison.OrdinalIgnoreCase)
        || (summary.Status.Equals("cancelled", StringComparison.OrdinalIgnoreCase) && summary.CompletedAt is null);

    private readonly record struct PositionSelectionKey(string Kind, long Id);

    public async ValueTask DisposeAsync()
    {
        Token.Changed -= OnTokenChanged;
        await pollCancellation.CancelAsync();
        if (pollTask is not null)
        {
            try { await pollTask; }
            catch (OperationCanceledException) { }
        }
        pollCancellation.Dispose();
    }
}
